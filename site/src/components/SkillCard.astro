---
import CommandBlock from "./CommandBlock.astro";
import OperationBadge from "./OperationBadge.astro";
import type { CatalogSkill } from "../lib/skills";
import { collectionLabel, installHostLabel } from "../lib/skills";
import { withBase } from "../lib/site";

interface Props {
  compact?: boolean;
  skill: CatalogSkill;
}

const { compact = false, skill } = Astro.props;
const href =
  skill.kind === "public" ? `/skills/${skill.name}/` : `/incubator/${skill.name}/`;
const defaultInstallCommand = skill.installCommands.find(
  ({ host }) => host === skill.defaultInstallHost,
);
const defaultInstallHost = installHostLabel(skill.defaultInstallHost);
const targetRuntime = skill.targetRuntime ? installHostLabel(skill.targetRuntime) : undefined;
const contractLabel = targetRuntime ? `Target contract: ${targetRuntime}` : "Portable contract";
---

<article
  class:list={[
    "skill-card",
    `skill-card--${skill.kind}`,
    { "skill-card--compact": compact }
  ]}
  data-reveal
>
  <div class="skill-card__topline">
    <span>{collectionLabel(skill.kind)}</span>
    <OperationBadge
      label={skill.categoryLabel}
      multiAgent={skill.category === "engineering-workflows"}
    />
  </div>
  <h3>
    <a href={withBase(href)}>{skill.name}</a>
  </h3>
  {compact ? (
    <>
      <p class="skill-card__summary">{skill.summary}</p>
      {skill.summary !== skill.description && (
        <details class="skill-card__description" data-description-disclosure>
          <summary>Full description</summary>
          <p data-description-content>{skill.description}</p>
        </details>
      )}
    </>
  ) : (
    <p>{skill.description}</p>
  )}
  <ul class="skill-card__meta" aria-label={`${skill.name} metadata`}>
    {skill.version && <li class="skill-card__version">v{skill.version}</li>}
    <li>{contractLabel}</li>
    <li>Install into: {defaultInstallHost}</li>
    {skill.hasOpenAiMetadata && <li>Codex metadata</li>}
    {skill.evalUrl && <li class="skill-card__proof">Eval proof</li>}
  </ul>
  {!compact && defaultInstallCommand && (
    <CommandBlock
      command={defaultInstallCommand.command}
      label={`${skill.name} install into ${defaultInstallHost}`}
    />
  )}
  <div class="skill-card__links">
    <a href={withBase(href)}>View skill</a>
    <a href={skill.sourceUrl} rel="noreferrer" target="_blank">Source</a>
    {skill.evalUrl && <a href={skill.evalUrl} rel="noreferrer" target="_blank">Proof</a>}
  </div>
</article>
