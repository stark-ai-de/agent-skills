---
import CommandBlock from "./CommandBlock.astro";
import type { CatalogSkill } from "../lib/skills";
import { collectionLabel } from "../lib/skills";
import { withBase } from "../lib/site";

interface Props {
  skill: CatalogSkill;
}

const { skill } = Astro.props;
const href =
  skill.kind === "public" ? `/skills/${skill.name}/` : `/incubator/${skill.name}/`;
const command = skill.installCommand ?? skill.localUsageCommand;
---

<article class="skill-card">
  <div class="skill-card__topline">
    <span>{collectionLabel(skill.kind)}</span>
    <span>{skill.categoryLabel}</span>
  </div>
  <h3>
    <a href={withBase(href)}>{skill.name}</a>
  </h3>
  <p>{skill.description}</p>
  <div class="skill-card__meta" aria-label={`${skill.name} metadata`}>
    {skill.version && <span>v{skill.version}</span>}
    {skill.hasOpenAiMetadata && <span>Codex metadata</span>}
    {skill.evalUrl && <span>Eval proof</span>}
  </div>
  {command && <CommandBlock command={command} label={`${skill.name} install command`} />}
  <div class="skill-card__links">
    <a href={withBase(href)}>Open page</a>
    <a href={skill.sourceUrl} rel="noreferrer" target="_blank">Source</a>
    {skill.evalUrl && <a href={skill.evalUrl} rel="noreferrer" target="_blank">Proof</a>}
  </div>
</article>
