---
const productUrl =
  "https://www.producthunt.com/products/agent-skills-by-stark-ai?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-agent-skills-by-stark-ai";
const badgeUrl =
  "https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1245476";
---

<a
  class="product-hunt-badge"
  href={productUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Find Agent Skills on Product Hunt (opens in a new tab)"
>
  <span class="product-hunt-badge__fallback" aria-hidden="true">
    Find us on
    <strong>Product Hunt</strong>
  </span>
  <img
    class="product-hunt-badge__light"
    src={`${badgeUrl}&theme=light`}
    alt=""
    width="250"
    height="54"
    decoding="async"
    referrerpolicy="no-referrer"
  />
  <img
    class="product-hunt-badge__dark"
    src={`${badgeUrl}&theme=dark`}
    alt=""
    width="250"
    height="54"
    decoding="async"
    referrerpolicy="no-referrer"
  />
</a>

<script>
  for (const image of document.querySelectorAll<HTMLImageElement>(".product-hunt-badge img")) {
    if (image.complete && image.naturalWidth === 0) {
      image.remove();
    } else {
      image.addEventListener("error", () => image.remove(), { once: true });
    }
  }
</script>

<style>
  .product-hunt-badge {
    position: relative;
    isolation: isolate;
    display: inline-block;
    width: 250px;
    height: 54px;
    max-width: 100%;
    border-radius: 10px;
    background: var(--surface-solid);
    color: var(--foreground);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .product-hunt-badge__fallback {
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    padding-inline: 1rem;
    font-size: 0.625rem;
    font-weight: 650;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .product-hunt-badge__fallback strong {
    font-size: 1.125rem;
    text-transform: none;
  }

  img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }

  .product-hunt-badge__light {
    display: block;
  }

  .product-hunt-badge__dark {
    display: none;
  }

  :global(:root[data-theme="dark"]) .product-hunt-badge__light {
    display: none;
  }

  :global(:root[data-theme="dark"]) .product-hunt-badge__dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .product-hunt-badge__light {
      display: none;
    }

    :global(:root:not([data-theme="light"])) .product-hunt-badge__dark {
      display: block;
    }
  }
</style>
