---
import type { SkillTreeNode } from "../lib/skills";

interface Props {
  nodes: SkillTreeNode[];
  root?: boolean;
}

const { nodes, root = false } = Astro.props;
---

<ul class:list={["skill-tree__list", { "skill-tree__list--root": root }]}>
  {
    nodes.map((node) =>
      node.kind === "directory" ? (
        <li class="skill-tree__item skill-tree__item--directory">
          <details class="skill-tree__directory" open>
            <summary class="skill-tree__summary">
              <svg
                class="skill-tree__icon skill-tree__icon--folder"
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3.5 7.75A1.75 1.75 0 0 1 5.25 6h4.1l1.7 2h7.7a1.75 1.75 0 0 1 1.75 1.75v7.5A1.75 1.75 0 0 1 18.75 19H5.25a1.75 1.75 0 0 1-1.75-1.75z"></path>
                <path d="M3.75 10.25h16.5"></path>
              </svg>
              <span class="skill-tree__name">{node.name}</span>
            </summary>
            <a
              class="skill-tree__marker"
              href={node.url}
              rel="noreferrer"
              target="_blank"
              aria-label={`Open ${node.path} on GitHub`}
              title={`Open ${node.path} on GitHub`}
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14 5h5v5"></path>
                <path d="m13 11 6-6"></path>
                <path d="M19 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"></path>
              </svg>
            </a>
            {
              node.children?.length ? (
                <Astro.self nodes={node.children} />
              ) : (
                <p class="skill-tree__empty">Empty folder</p>
              )
            }
          </details>
        </li>
      ) : (
        <li class="skill-tree__item skill-tree__item--file">
          <div class="skill-tree__entry">
            <a
              class="skill-tree__entry-label"
              href={node.url}
              rel="noreferrer"
              target="_blank"
              aria-label={`Open ${node.path} on GitHub`}
              title={`Open ${node.path} on GitHub`}
            >
              <svg
                class="skill-tree__icon skill-tree__icon--file"
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6.5 3.75h7.25L18 8v12.25H6.5z"></path>
                <path d="M13.5 3.75V8H18"></path>
                <path d="M9.5 12h5"></path>
                <path d="M9.5 15.5h5"></path>
              </svg>
              <span class="skill-tree__name">{node.name}</span>
              <span class="skill-tree__marker" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14 5h5v5"></path>
                  <path d="m13 11 6-6"></path>
                  <path d="M19 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"></path>
                </svg>
              </span>
            </a>
          </div>
        </li>
      ),
    )
  }
</ul>
