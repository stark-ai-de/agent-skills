---
import type { CategoryGroup } from "../lib/skills";
import { withBase } from "../lib/site";
import OperationBadge from "./OperationBadge.astro";

interface Props {
  basePath?: string;
  groups: CategoryGroup[];
  label: string;
}

const { basePath, groups, label } = Astro.props;

const hrefForCategory = (category: string) =>
  basePath ? `${withBase(basePath)}#${category}` : `#${category}`;
---

{
  groups.length > 0 && (
    <nav class="category-nav" aria-label={label}>
      {groups.map((group) => (
        <a href={hrefForCategory(group.category)} data-focus-target>
          <OperationBadge bare label={group.label} />
          <small>{group.skills.length}</small>
        </a>
      ))}
    </nav>
  )
}
