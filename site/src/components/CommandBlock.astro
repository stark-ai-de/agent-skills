---
interface Props {
  command: string;
  iconOnly?: boolean;
  label: string;
}

const { command, iconOnly = false, label } = Astro.props;
const copyLabel = `Copy ${label}`;
---

<div class="command-copy" data-command-block>
  <div class="command-copy__toolbar">
    <span class="command-copy__label">
      <span class="command-copy__prompt" aria-hidden="true">$</span>
      <span class="command-copy__label-text">{label}</span>
    </span>
    <button
      class:list={["copy-command-button", { "copy-command-button--icon-only": iconOnly }]}
      type="button"
      data-copy-command={command}
      aria-label={copyLabel}
      title={copyLabel}
    >
      <svg
        class="copy-command-button__icon copy-command-button__icon--copy"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <svg
        class="copy-command-button__icon copy-command-button__icon--done"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
      {!iconOnly && <span data-copy-button-label>Copy</span>}
    </button>
  </div>
  <pre class="command-line" data-command-line aria-label={label}><code>{command}</code></pre>
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</div>
