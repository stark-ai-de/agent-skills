---
import { jevBenchmarks as bench } from "../lib/jev-benchmarks.mjs";
import { repoUrl } from "../lib/skills";
import ContextTooltip from "./ContextTooltip.astro";

const number = (value: number) => value.toLocaleString("en-US");
const comparison = bench.current;
const optimization = comparison.optimization;
const initial = comparison.rows.find((row) => row.id === comparison.defaultId)!;
const chartMax = Math.ceil(Math.max(...comparison.rows.map((row) => row.medianSeconds)));
const chartWidth = 540;
const runs = [
  { label: "Next-skill qualification", count: bench.runCounts.nextSkillQualification, detail: "480 paired comparison observations + 9 development checks; no offline replays or diagnostic calls" },
  { label: "Optimization development", count: bench.runCounts.nextSkillDevelopment, detail: "Earlier rejected candidates retained, including one HTTP 402 refusal; 107 unexecuted slots excluded" },
  { label: "Resumed qualification", count: bench.runCounts.resumedQualification, detail: "10 cohorts; rejected shorter-description variants retained; health probe excluded" },
  { label: "Session index qualification", count: bench.runCounts.sessionIndexQualification, detail: "480 matched + 400 mixed observations; offline replay excluded" },
  { label: "Current Native supplement", count: bench.runCounts.nativeIndexSupplement, detail: "48 identical tasks × 2 new Native observations" },
  { label: "Compact selection development", count: bench.runCounts.compactDevelopment, detail: "8 cohorts; includes 150 HTTP 402 rejections, excluded from speed and quality comparisons" },
  { label: "Session and selector development", count: bench.runCounts.sessionDevelopment, detail: "37 completed experiments, including 384 fresh-task comparisons" },
  { label: "Retrieval evaluations", count: bench.runCounts.retrieval, detail: "270 tasks × 4 configurations" },
  { label: "Live selection evaluations", count: bench.runCounts.liveSelection, detail: "160 + 100 + 32 + 160 runs" },
  { label: "Runtime measurements", count: bench.runCounts.runtime, detail: "320 + 80 fresh-process measurements" },
  { label: "Native supplement", count: bench.runCounts.nativeSupplement, detail: "48 existing holdout tasks × 2 native observations" },
  { label: "Archived replay evaluations", count: bench.runCounts.replay, detail: "100 recorded-response replays" },
];
---

<section class="jev-promo" id="selection-speed" aria-labelledby="jev-benchmark-title" data-jev-promo>
  <header class="jev-promo__header">
    <div>
      <p class="jev-promo__label">General profile · study from 2026-09-23</p>
      <h2 id="jev-benchmark-title">Selection speed, measured.</h2>
      <p>Find a relevant skill or tool. Give your agent a focused next step.</p>
    </div>
    <a class="jev-promo__source" href={repoUrl(bench.readmePath)}>Read the benchmark README</a>
  </header>

  <div class="jev-promo__comparison">
    <div class="jev-promo__headline">
      <p class="jev-promo__ratio" data-jev-ratio aria-hidden="true"><b data-jev-factor>{initial.factor!.toFixed(2)}</b><span>×</span></p>
      <h3 class="jev-promo__comparison-title"><span data-jev-comparison-label>{initial.label} vs native</span></h3>
      <p class="jev-promo__description"><span data-jev-comparison-description>{initial.description}</span></p>
      <p class="jev-promo__quality"><strong>Correct accepted selections</strong><br />
        <span class="jev-promo__score" data-jev-score data-perfect={String(initial.observations > 0 && initial.correct === initial.observations)}>
          <span data-jev-quality>{initial.correct}/{initial.observations}</span>
          <span class="jev-promo__sparkles" aria-hidden="true">
            {[0, 1, 2].map((star) => (
              <svg class={`jev-promo__star jev-promo__star--${star}`} viewBox="0 0 32 32" focusable="false">
                <defs><linearGradient id={`jev-star-gold-${star}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff9da" /><stop offset="0.35" stop-color="#ffe58a" /><stop offset="0.65" stop-color="#e9ae24" /><stop offset="1" stop-color="#a56a08" /></linearGradient></defs>
                <path d="m16 2 4.3 8.9 9.7 1.4-7 6.8 1.6 9.7-8.6-4.6-8.6 4.6 1.6-9.7-7-6.8 9.7-1.4Z" fill={`url(#jev-star-gold-${star})`} stroke="#bc861b" stroke-width="0.7" stroke-linejoin="round" />
                <path d="M16 2v14l-4.3-5.1Z" fill="#fffdf0" opacity="0.9" />
                <path d="M30 12.3 16 16l4.3-5.1Z" fill="#fff2b0" />
                <path d="m24.6 28.8-8.6-12.8 7 3.1Z" fill="#a86c0c" opacity="0.75" />
                <path d="m7.4 28.8 8.6-12.8v8.2Z" fill="#ffd35c" />
                <path d="m13 10 1 3 3 1-3 1-1 3-1-3-3-1 3-1Z" fill="#fff" opacity="0.85" />
              </svg>
            ))}
          </span>
        </span>
      </p>
      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-jev-announcement>{initial.announcement}</p>
    </div>

    <figure class="jev-promo__chart" data-jev-chart>
      <figcaption>Skill selection · median · lower is better<span>Fastest first, including our internal experiment; Native restores Jev Session. Use the info buttons for technical details.</span></figcaption>
      <div class="jev-promo__rows">
        {comparison.rows.map((row) => {
          const Row = row.id === comparison.baselineId ? "div" : "button";
          return (
          <div class="jev-promo__entry" data-jev-entry={row.id}>
            <div class="jev-promo__chart-label">
              <span class="jev-promo__chart-name"><strong>{row.label}</strong>{row.sourceUrl && (
                <a class="jev-promo__github" href={row.sourceUrl} target="_blank" rel="noreferrer" aria-label="Open Hussi9 skill-router on GitHub (new tab)">
                  <span aria-hidden="true">(</span>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.95 10.95 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
                  <span aria-hidden="true">)</span>
                </a>
              )}{row.experimental && <span class="jev-promo__experiment-badge">Our experiment</span>}</span>
              <span class="jev-promo__time">{row.medianSeconds.toFixed(2)} s</span>
              <ContextTooltip id={`jev-info-${row.id}`} label={row.label} text={row.info} align="end" />
            </div>
            <Row type={row.id === comparison.baselineId ? undefined : "button"} role={row.id === comparison.baselineId ? "img" : undefined} class="jev-promo__row" data-jev-row={row.id}
              data-factor={row.factor === null ? "" : row.factor.toFixed(2)} data-label={row.label}
              data-description={row.description} data-quality={`${row.correct}/${row.observations}`}
              data-perfect={String(row.observations > 0 && row.correct === row.observations)}
              data-announcement={row.announcement} aria-label={row.announcement}
              aria-pressed={row.id === comparison.baselineId ? undefined : row.id === comparison.defaultId}>
              <svg viewBox="0 0 540 26" aria-hidden="true">
                <rect class="jev-promo__track" x="0" y="3" width={chartWidth} height="20" rx="4" />
                <rect class={`jev-promo__bar jev-promo__bar--${row.id}`} x="0" y="3" width={chartWidth * row.medianSeconds / chartMax} height="20" rx="4" />
              </svg>
            </Row>
          </div>
          );
        })}
      </div>
      <svg class="jev-promo__axis" viewBox="0 0 540 30" aria-hidden="true">
        {[0, chartMax / 4, chartMax / 2, chartMax * 3 / 4, chartMax].map((tick) => (
          <text x={tick / chartMax * chartWidth} y="22" text-anchor={tick === 0 ? "start" : tick === chartMax ? "end" : "middle"}>{Number.isInteger(tick) ? tick.toFixed(0) : tick.toFixed(2)} s</text>
        ))}
      </svg>
      <p class="jev-promo__models">Native: {comparison.nativeModel} · reasoning {comparison.nativeReasoning}<br />Jev + Hussi9: {comparison.jevModel}</p>
      <p class="jev-promo__caption"><strong>Historical general-profile comparison.</strong> {comparison.skillObservations} observations per variant · same tasks and catalog, separate measurement runs ({comparison.dateLabel}). Ratios of medians; selection only. These timings do not measure the new next-skill profile. Session requires a retained process. Process startup, skill loading and task execution excluded.</p>
    </figure>
  </div>

  <section class="jev-promo__technical jev-promo__compact" aria-labelledby="jev-compact-title">
    <p class="jev-promo__label">Earlier optimization · 2026-09-23</p>
    <h3 id="jev-compact-title">{optimization.title}</h3>
    <p><strong>{optimization.reductionPercent.toFixed(1)}% lower median selection time</strong> across skills, MCP tools, clarification, no match and compound tasks in a {optimization.catalogRecords}-entry catalog. Same inputs and selection rules, reusable HTTPS in both variants.</p>
    <div class="jev-promo__table-scroll" role="region" aria-label="Session index results" tabindex="0">
      <table>
        <caption>Mixed selection · median · lower is better · 200 observations per variant</caption>
        <thead><tr><th scope="col">Variant</th><th scope="col">Median</th><th scope="col">Complete correct results</th><th scope="col">Errors</th></tr></thead>
        <tbody>{optimization.rows.map((row) => <tr><th scope="row">{row.label}</th><td>{row.median_ms.toFixed(0)} ms</td><td>{row.correct}/{row.n}</td><td>{row.errors}</td></tr>)}</tbody>
      </table>
    </div>
    <dl class="jev-promo__technical-mobile">
      {optimization.rows.map((row) => (
        <div><dt>{row.label}</dt><dd><strong>{row.median_ms.toFixed(0)} ms</strong>Median selection</dd><dd><strong>{row.correct}/{row.n} correct</strong>{row.errors} errors retained</dd></div>
      ))}
    </dl>
    <ul>{optimization.notes.map((note) => <li><strong>{note.title}.</strong> {note.text}</li>)}</ul>
    <p>The smaller skill-only catalog did not show the same total-speed benefit: Session was {optimization.smallCatalogChangePercent.toFixed(1)}% slower than our previous preparation, with 79/80 versus 80/80 accepted choices. Local preparation fell, while request time increased. These measurements do not establish the fastest skill overall.</p>
    <p class="jev-promo__technical-source"><a href={repoUrl(comparison.evidencePath)}>Both complete cohorts and paired intervals</a> · <a href={repoUrl(comparison.parityPath)}>Recorded-response equivalence</a></p>
  </section>

  <div class="jev-promo__stats">
    <div>
      <p class="jev-promo__stat">{number(Math.floor(bench.totalRuns / 1000) * 1000)}+</p>
      <h3>Benchmark runs</h3>
      <p>Across development iterations, including baseline and candidate variants.</p>
      <a href="#jev-run-count">See the {number(bench.totalRuns)}-run breakdown</a>
    </div>
    <div>
      <p class="jev-promo__stat">{bench.compactReduction.toFixed(1)}<span>%</span></p>
      <h3>Less returned JSON</h3>
      <p>Complete selected descriptions, compact advice. Measured on {bench.compactCases} archived results; bytes, not tokens.</p>
    </div>
    <div>
      <p class="jev-promo__stat">{optimization.preparationReductionPercent.toFixed(1)}<span>%</span></p>
      <h3>Less repeated preparation</h3>
      <p>Median local preparation in the {optimization.catalogRecords}-entry mixed catalog. Same inputs; first index builds included.</p>
    </div>
  </div>

  <section class="jev-promo__technical" aria-labelledby="jev-technical-title">
    <h3 id="jev-technical-title">{comparison.technical.title}</h3>
    <p>{comparison.technical.introduction}</p>
    <div class="jev-promo__table-scroll" role="region" aria-label="Technical routing comparison" tabindex="0">
      <table>
        <caption class="sr-only">Published Hussi9 chooser compared with Jev Capability Advisor</caption>
        <thead><tr><th scope="col">Difference</th><th scope="col">Hussi9 chooser</th><th scope="col">Jev advisor</th></tr></thead>
        <tbody>{comparison.technical.rows.map((row) => (
          <tr><th scope="row">{row.topic}</th><td>{row.hussi}</td><td>{row.jev}</td></tr>
        ))}</tbody>
      </table>
    </div>
    <dl class="jev-promo__technical-mobile">
      {comparison.technical.rows.map((row) => (
        <div><dt>{row.topic}</dt><dd><strong>Hussi9</strong>{row.hussi}</dd><dd><strong>Jev advisor</strong>{row.jev}</dd></div>
      ))}
    </dl>
    <ul>{comparison.technical.notes.map((note) => <li><strong>{note.title}.</strong> {note.text}</li>)}</ul>
    <h3 id="jev-experiment-title">{comparison.experiment.title}</h3>
    <ul>{comparison.experiment.notes.map((note) => <li><strong>{note.title}.</strong> {note.text}</li>)}</ul>
    <p class="jev-promo__technical-source"><a href={comparison.hussiSource}>Pinned Hussi9 source</a> · <a href={repoUrl(bench.readmePath) + "#why-routing-speeds-differ"}>Technical notes and evidence</a></p>
  </section>

  <div class="jev-promo__features">
    <div><h3>A useful recommendation.<br />An inspectable decision.</h3><p>Built for the capabilities your agent actually has available.</p></div>
    <dl>
      <div><dt>Skills + MCP tools</dt><dd>Compare workflows and tools in one supplied catalog.</dd></div>
      <div><dt>Clear outcomes</dt><dd>A recommendation, no match, missing context or a provider error.</dd></div>
      <div><dt>Reusable sessions</dt><dd>Keep HTTPS and a bounded search index; validate a fresh catalog for each task.</dd></div>
      <div><dt>Offline inspection</dt><dd>Explore candidates without an API key or network call.</dd></div>
      <div><dt>Your host stays in control</dt><dd>Loading, permissions and execution remain with your agent.</dd></div>
    </dl>
  </div>

  <details class="jev-promo__details">
    <summary>Results, comparison sources and session requirements</summary>
    <div class="jev-promo__details-body">
      <p>Forty single-skill tasks and eight no-match tasks, balanced between German and English, each ran twice. The four displayed Jev-based variants and our previous preparation ran together in randomized order; Native ran later with identical cards and rules. The previous preparation appears in the evidence, not as an extra headline bar. All skill observations contribute to the median, including incorrect selections. Provider load and caching were uncontrolled; this is a comparison across separate measurement runs.</p>
      <div class="jev-promo__table-scroll" role="region" aria-label="Five-variant selection results" tabindex="0">
        <table>
          <caption>Same 48 tasks · two observations per variant and task · {comparison.displayedObservations} observations</caption>
          <thead><tr><th scope="col">Variant</th><th scope="col">Median</th><th scope="col">p95</th><th scope="col">Correct accepted selections</th><th scope="col">No match correct</th><th scope="col">Errors</th></tr></thead>
          <tbody>{comparison.rows.map((row) => <tr><th scope="row">{row.label}</th><td>{row.medianSeconds.toFixed(3)} s</td><td>{row.p95Seconds.toFixed(3)} s</td><td>{row.correct}/{row.observations}</td><td>{row.noneCorrect}/{row.noneObservations}</td><td>{row.errors}</td></tr>)}</tbody>
        </table>
      </div>
      <p><a href={comparison.hussiSource}>Hussi9's published Jev selection component</a> uses its original 1.2-second timeout and 0.8 confidence gate. We measured selection, not its complete router, hooks or fallback workflow. The experimental row shows our modified transport adapter, not a published Hussi9 release. Each completed observation is counted once; rendering it again adds no runs. These results do not establish an overall fastest product.</p>
      <p>The actual Jev session API received a fresh catalog every time. Session construction, validation, preparation, API calls and evidence recording were timed. The first cold call in each repetition is included; no prewarming, result cache, disk index cache or retry was used. Session reuses one bounded derived index; Fresh constructs and closes a real Session every time, including its initial index retention checks. Native timing includes the unchanged baseline preparation and model turn, with CLI startup recorded separately. Native was requested as {comparison.nativeModel} with reasoning {comparison.nativeReasoning}; its resolved backend identity was not independently observable. Native reported provider-side prefix-cache use in 51/96 turns; this is not a decision cache.</p>
      <p>A host must retain the session and supply authoritative current inventory. Proxies use an unpooled fallback. Skill/plugin installation does not install an automatic hook; a whole-task speedup has not been demonstrated. The headline task set contains skills and no-match cases; the separate 100-task mixed suite covers MCP, compound and clarification outcomes. The older 80-task comparison below remains separate.</p>
      <a href={repoUrl(comparison.evidencePath)}>Read the comparison evidence</a>
    </div>
  </details>

  <details class="jev-promo__details" id="jev-run-count">
    <summary>What counts as {number(bench.totalRuns)} benchmark runs?</summary>
    <div class="jev-promo__details-body">
      <p>Completed benchmark executions across development revisions. Repeated tasks and comparison variants count as separate runs. This is not a count of unique tasks, passing tests or API requests.</p>
      <div class="jev-promo__table-scroll" role="region" aria-label="Benchmark run breakdown" tabindex="0">
        <table>
          <caption>Recorded development measurements</caption>
          <thead><tr><th scope="col">Experiment</th><th scope="col">Runs</th><th scope="col">Counted once</th></tr></thead>
          <tbody>{runs.map((run) => <tr><th scope="row">{run.label}</th><td>{number(run.count)}</td><td>{run.detail}</td></tr>)}</tbody>
          <tfoot><tr><th scope="row">Total</th><td>{number(bench.totalRuns)}</td><td>Warmups, rescorings and assertions excluded</td></tr></tfoot>
        </table>
      </div>
    </div>
  </details>

  <details class="jev-promo__details">
    <summary>Earlier native comparison: {bench.speedRatio.toFixed(2)}× faster median selection</summary>
    <div class="jev-promo__details-body">
      <div class="jev-promo__table-scroll" role="region" aria-label="Selection benchmark results" tabindex="0">
        <table>
          <caption>Earlier pre-session selection comparison · {bench.date}</caption>
          <thead><tr><th scope="col">Measure</th><th scope="col">Jev advisor</th><th scope="col">Native selector</th></tr></thead>
          <tbody>
            <tr><th scope="row">Median selection</th><td><strong>{bench.jev.medianSeconds.toFixed(3)} s</strong></td><td>{bench.native.medianSeconds.toFixed(3)} s</td></tr>
            <tr><th scope="row">p95 selection</th><td>{bench.jev.p95Seconds.toFixed(3)} s</td><td>{bench.native.p95Seconds.toFixed(3)} s</td></tr>
            <tr><th scope="row">Correct complete results</th><td>{bench.jev.correct}/{bench.tasks}</td><td>{bench.native.correct}/{bench.tasks}</td></tr>
          </tbody>
        </table>
      </div>
      <p>Both selectors received the same {bench.candidates} ordered cards per task from a {bench.catalogSize}-entry catalog. Task and arm order were randomized, with one sample per arm/task, no retries and no local caches. Provider caching and service load were uncontrolled.</p>
      <p>The headline is the ratio of medians. These are previously used synthetic regressions, not a fresh holdout. Single-task, no-match and clarification results tied at 58/60; compound results were 12/20 for Jev and 14/20 for native. All failures remain counted.</p>
      <p>Whole-host pilots have not shown faster task completion. Automatic prompt interception remains unqualified; the new session API is an integration building block. The cumulative run count covers earlier revisions too; it does not expand this earlier comparison beyond {bench.tasks} tasks.</p>
    </div>
  </details>

  <footer class="jev-promo__footer">
    <span>Measured {comparison.dateLabel} · Release candidate</span>
    <div><a href={repoUrl(comparison.evidencePath)}>Latest optimization</a><a href={repoUrl(comparison.nativeEvidencePath)}>Native data</a><a href={repoUrl(bench.session.evidencePath)}>Session data</a><a href={repoUrl(bench.countsPath)}>Earlier count ledger</a><a href={repoUrl(bench.evidencePath)}>Earlier data</a><a href={repoUrl(bench.methodsPath)}>Full methods and results</a></div>
  </footer>
</section>

<script>
  const promo = document.querySelector<HTMLElement>("[data-jev-promo]");
  const chart = promo?.querySelector<HTMLElement>("[data-jev-chart]");
  const rows = Array.from(chart?.querySelectorAll<HTMLElement>("[data-jev-row]") ?? []);
  const defaultRow = rows.find((row) => row.dataset.jevRow === "jev_session");
  if (promo && chart && defaultRow) {
    const factor = promo.querySelector<HTMLElement>("[data-jev-factor]")!;
    const label = promo.querySelector<HTMLElement>("[data-jev-comparison-label]")!;
    const description = promo.querySelector<HTMLElement>("[data-jev-comparison-description]")!;
    const quality = promo.querySelector<HTMLElement>("[data-jev-quality]")!;
    const score = promo.querySelector<HTMLElement>("[data-jev-score]")!;
    const announcement = promo.querySelector<HTMLElement>("[data-jev-announcement]")!;
    if ("IntersectionObserver" in window) {
      const revealScore = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.75) {
          score.dataset.revealed = "true";
          revealScore.disconnect();
        }
      }, { threshold: 0.75 });
      revealScore.observe(score);
    }
    let focusedRow: HTMLElement | null = null;
    let selectedRow = defaultRow;
    const select = (requested: HTMLElement) => {
      const baseline = requested.dataset.factor === "";
      if (baseline) focusedRow = null;
      const row = baseline ? defaultRow : requested;
      if (row === selectedRow) return;
      selectedRow = row;
      factor.textContent = row.dataset.factor ?? "";
      label.textContent = `${row.dataset.label} vs native`;
      description.textContent = row.dataset.description ?? "";
      quality.textContent = row.dataset.quality ?? "";
      score.dataset.perfect = row.dataset.perfect;
      announcement.textContent = row.dataset.announcement ?? "";
      rows.filter((item) => item instanceof HTMLButtonElement).forEach((item) => item.setAttribute("aria-pressed", String(item === row)));
    };
    rows.forEach((row) => {
      const entry = row.closest<HTMLElement>("[data-jev-entry]")!;
      entry.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "touch") select(row);
      });
      entry.addEventListener("focusin", (event) => {
        focusedRow = event.target instanceof Element && event.target.matches(":focus-visible") ? row : null;
        select(row);
      });
      entry.addEventListener("click", () => select(row));
    });
    chart.querySelectorAll<HTMLElement>(".context-tip").forEach((tip) => {
      const card = tip.querySelector<HTMLElement>(".context-tip__card")!;
      const position = () => {
        const trigger = tip.getBoundingClientRect();
        tip.dataset.side = trigger.bottom + card.offsetHeight + 12 > window.innerHeight && trigger.top > card.offsetHeight + 16 ? "above" : "below";
      };
      tip.addEventListener("pointerenter", position);
      tip.addEventListener("focusin", position);
      tip.addEventListener("pointerdown", position);
    });
    chart.addEventListener("pointerleave", (event) => {
      if (event.pointerType !== "touch") select(focusedRow ?? defaultRow);
    });
    chart.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !chart.contains(event.relatedTarget)) {
        focusedRow = null;
        select(defaultRow);
      }
    });
    chart.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        focusedRow = null;
        select(defaultRow);
      }
    });
    document.addEventListener("pointerdown", (event) => {
      // Outside taps also dismiss a tooltip whose trigger retains touch focus.
      chart.querySelectorAll<HTMLElement>(".context-tip[data-open='true'], .context-tip:focus-within, .context-tip:hover").forEach((tip) => {
        if (event.target instanceof Node && !tip.contains(event.target)) {
          tip.dataset.dismissed = "true";
          delete tip.dataset.open;
          tip.querySelector("[data-context-tip-trigger]")?.setAttribute("aria-expanded", "false");
        }
      });
      if (event.target instanceof Node && !chart.contains(event.target)) {
        focusedRow = null;
        select(defaultRow);
      }
    });
  }
  if (promo && !window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        promo.classList.add("jev-promo--animate");
        observer.disconnect();
      }
    }, { threshold: 0.1 });
    observer.observe(promo);
  }
  document.querySelector<HTMLAnchorElement>('a[href="#jev-run-count"]')?.addEventListener("click", () => {
    const details = document.querySelector<HTMLDetailsElement>("#jev-run-count");
    if (details) details.open = true;
  });
