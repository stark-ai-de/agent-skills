---
import { jevBenchmarks as bench, getJevPromoComparison } from "../lib/jev-benchmarks.mjs";
import { repoUrl } from "../lib/skills";
import ContextTooltip from "./ContextTooltip.astro";
import JevFeatureStatus from "./JevFeatureStatus.astro";
import JevNextSkillComparison from "./JevNextSkillComparison.astro";
import { nextSkillComparison } from "../lib/jev-next-skill-benchmarks.mjs";

const number = (value: number) => value.toLocaleString("en-US");
const comparison = getJevPromoComparison();
const history = bench.current;
const optimization = history.optimization;
const nextSkill = nextSkillComparison(bench.nextSkillEvidence);
const confirmation = nextSkill.cohorts[1];
const confirmedInputSaving = comparison.inputSaving;
const initial = comparison.rows.find((row) => row.id === comparison.defaultId)!;
const chartMax = Math.ceil(Math.max(...comparison.rows.map((row) => row.medianSeconds)));
const chartWidth = 540;
const featureRows = initial.features.map((feature, index) => ({ ...feature, alternatives: comparison.rows.map((row) => row.features[index].value) }));
const runs = [
  { label: "Next-skill Native supplement", count: comparison.completedNativeExecutions, detail: "32 frozen tasks × 2 Native observations; earlier Jev/Hussi observations reused, not counted again" },
  { label: "Next-skill qualification", count: bench.runCounts.nextSkillQualification, detail: "480 paired comparison observations + 9 development checks; no offline replays or diagnostic calls" },
  { label: "Optimization development", count: bench.runCounts.nextSkillDevelopment, detail: "Earlier rejected candidates retained, including one HTTP 402 refusal; 107 unexecuted slots excluded" },
  { label: "Resumed qualification", count: bench.runCounts.resumedQualification, detail: "10 cohorts; rejected shorter-description variants retained; health probe excluded" },
  { label: "Session index qualification", count: bench.runCounts.sessionIndexQualification, detail: "480 matched + 400 mixed observations; offline replay excluded" },
  { label: "Earlier general-profile Native supplement", count: bench.runCounts.nativeIndexSupplement, detail: "48 identical tasks × 2 new Native observations" },
  { label: "Compact selection development", count: bench.runCounts.compactDevelopment, detail: "8 cohorts; includes 150 HTTP 402 rejections, excluded from speed and quality comparisons" },
  { label: "Session and selector development", count: bench.runCounts.sessionDevelopment, detail: "37 completed experiments, including 384 fresh-task comparisons" },
  { label: "Retrieval evaluations", count: bench.runCounts.retrieval, detail: "270 tasks × 4 configurations" },
  { label: "Live selection evaluations", count: bench.runCounts.liveSelection, detail: "160 + 100 + 32 + 160 runs" },
  { label: "Runtime measurements", count: bench.runCounts.runtime, detail: "320 + 80 fresh-process measurements" },
  { label: "Native supplement", count: bench.runCounts.nativeSupplement, detail: "48 existing holdout tasks × 2 native observations" },
  { label: "Archived replay evaluations", count: bench.runCounts.replay, detail: "100 recorded-response replays" },
];
---

<section class="jev-promo" id="benchmarks" aria-labelledby="jev-benchmark-title" data-jev-promo>
  <header class="jev-promo__header">
    <div>
      <p class="jev-promo__label">Powered by TypeSafe Jev</p>
      <h2 id="jev-benchmark-title">Less choosing. More doing.</h2>
      <p>Help your agent pick the right skill or MCP tool — and get on with the task.</p>
    </div>
    <a class="jev-promo__source" href="#skill-guide">How to use it <span aria-hidden="true">↗</span></a>
  </header>

  <div class="jev-promo__comparison" id="selection-speed">
    <div class="jev-promo__headline">
      <p class="jev-promo__speed-label" data-jev-speed-label>{initial.speedLabel}</p>
      <p class="jev-promo__ratio" data-jev-ratio aria-hidden="true"><b data-jev-factor>{initial.factor!.toFixed(2)}</b><span>×</span></p>
      <h3 class="jev-promo__comparison-title"><span data-jev-comparison-label>{initial.label} vs native</span>{comparison.rows.map((row) => <span class="jev-promo__reserve" aria-hidden="true">{row.label} vs native</span>)}</h3>
      <p class="jev-promo__description"><span data-jev-comparison-description>{initial.description}</span>{comparison.rows.map((row) => <span class="jev-promo__reserve" aria-hidden="true">{row.description}</span>)}</p>
      <p class="jev-promo__secondary"><strong>{comparison.hussiFactor.toFixed(2)}×</strong> Jev Session vs published Hussi9</p>
      <p class="jev-promo__quality"><strong>Correct skill choices</strong><br />
        <span class="jev-promo__score" data-jev-score data-perfect={String(initial.observations > 0 && initial.correct === initial.observations)}>
          <span data-jev-quality>{initial.correct}/{initial.observations}</span>
          <span class="jev-promo__sparkles" aria-hidden="true">
            {[0, 1, 2].map((star) => (
              <svg class={`jev-promo__star jev-promo__star--${star}`} viewBox="0 0 32 32" focusable="false">
                <defs><linearGradient id={`jev-star-gold-${star}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff9da" /><stop offset="0.35" stop-color="#ffe58a" /><stop offset="0.65" stop-color="#e9ae24" /><stop offset="1" stop-color="#a56a08" /></linearGradient></defs>
                <path d="m16 2 4.3 8.9 9.7 1.4-7 6.8 1.6 9.7-8.6-4.6-8.6 4.6 1.6-9.7-7-6.8 9.7-1.4Z" fill={`url(#jev-star-gold-${star})`} stroke="#bc861b" stroke-width="0.7" stroke-linejoin="round" />
                <path d="M16 2v14l-4.3-5.1Z" fill="#fffdf0" opacity="0.9" />
                <path d="M30 12.3 16 16l4.3-5.1Z" fill="#fff2b0" />
                <path d="m24.6 28.8-8.6-12.8 7 3.1Z" fill="#a86c0c" opacity="0.75" />
                <path d="m7.4 28.8 8.6-12.8v8.2Z" fill="#ffd35c" />
                <path d="m13 10 1 3 3 1-3 1-1 3-1-3-3-1 3-1Z" fill="#fff" opacity="0.85" />
              </svg>
            ))}
          </span>
        </span>
      </p>
      <div class="jev-promo__feature-heading">
        <h3 id="jev-supported-features">Supported Features</h3>
        <ContextTooltip id="jev-feature-scope" label="Supported Features" align="end" text={[
          "Skills: recommends a saved workflow.",
          "MCP tools: recommends a connected tool.",
          "16k characters: how much task text can reach Jev.",
          "HTTPS reuse: keeps the connection open for the next request.",
          "Index reuse: keeps catalog search data ready.",
          "✓ Available · × Not supported · ? Not checked or not used here.",
          "These are product features. The bars time skill selection only.",
        ].join("\n\n")} />
      </div>
      <ul class="jev-promo__features" aria-labelledby="jev-supported-features" data-jev-features>
        {featureRows.map((feature, index) => (
          <li data-jev-feature data-status={feature.status}>
            <JevFeatureStatus id={`jev-feature-gloss-${index}`} status={feature.status} />
            <span><strong>{feature.label}</strong><span class="jev-promo__feature-values">
              <span data-jev-feature-value>{feature.value}</span>
              {feature.alternatives.map((value) => <span class="jev-promo__reserve" aria-hidden="true">{value}</span>)}
            </span></span>
          </li>
        ))}
      </ul>
      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-jev-announcement>{initial.announcement}</p>
    </div>

    <figure class="jev-promo__chart" data-jev-chart>
      <figcaption>Skill selection · median · lower is better<span>Hover or tap a bar. Your selection stays while you read.</span></figcaption>
      <div class="jev-promo__rows">
        {comparison.rows.map((row) => {
          const Row = row.id === comparison.baselineId ? "div" : "button";
          return (
          <div class="jev-promo__entry" data-jev-entry={row.id}>
            <div class="jev-promo__chart-label">
              <span class="jev-promo__chart-name"><strong>{row.label}</strong>{(row.sourceUrl || row.sourcePath) && (
                <a class="jev-promo__github" href={row.sourceUrl ?? repoUrl(row.sourcePath!)} target="_blank" rel="noreferrer" aria-label={row.githubAriaLabel}>
                  <span aria-hidden="true">(</span>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.95 10.95 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
                  <span aria-hidden="true">)</span>
                </a>
              )}{row.experimental && <span class="jev-promo__experiment-badge">Internal · unpublished</span>}</span>
              <span class="jev-promo__time">{row.medianSeconds.toFixed(2)} s</span>
              <ContextTooltip id={`jev-info-${row.id}`} label={row.label} text={row.info} align="end" />
            </div>
            <Row type={row.id === comparison.baselineId ? undefined : "button"} role={row.id === comparison.baselineId ? "img" : undefined} class="jev-promo__row" data-jev-row={row.id}
              data-factor={row.factor === null ? "" : row.factor.toFixed(2)} data-label={row.label}
              data-speed-label={row.speedLabel}
              data-features={JSON.stringify(row.features)} data-description={row.description} data-quality={`${row.correct}/${row.observations}`}
              data-perfect={String(row.observations > 0 && row.correct === row.observations)}
              data-announcement={row.announcement} aria-label={row.announcement}
              aria-pressed={row.id === comparison.baselineId ? undefined : row.id === comparison.defaultId}>
              <svg viewBox="0 0 540 26" aria-hidden="true">
                <rect class="jev-promo__track" x="0" y="3" width={chartWidth} height="20" rx="4" />
                <rect class={`jev-promo__bar jev-promo__bar--${row.id}`} x="0" y="3" width={chartWidth * row.medianSeconds / chartMax} height="20" rx="4" />
              </svg>
            </Row>
          </div>
          );
        })}
      </div>
      <svg class="jev-promo__axis" viewBox="0 0 540 30" aria-hidden="true">
        {[0, chartMax / 4, chartMax / 2, chartMax * 3 / 4, chartMax].map((tick) => (
          <text x={tick / chartMax * chartWidth} y="22" text-anchor={tick === 0 ? "start" : tick === chartMax ? "end" : "middle"}>{Number.isInteger(tick) ? tick.toFixed(0) : tick.toFixed(2)} s</text>
        ))}
      </svg>
      <p class="jev-promo__models">Native: {comparison.nativeModel} · reasoning {comparison.nativeReasoning}<br />Jev + Hussi9: {comparison.jevModel}</p>
      <p class="jev-promo__caption">{comparison.skillObservations} skill choices per variant · {comparison.dateLabel} · same tasks and catalog, separate runs. Session needs a running process. Our unpublished experiment remains in the full results. <a href="#jev-speed-method" data-jev-disclosure="jev-speed-details">Method &amp; scope</a></p>
    </figure>
  </div>

  <div class="jev-promo__proof" role="group" aria-label="Selection input and development record">
    <div><p class="jev-promo__proof-number">{confirmedInputSaving.toFixed(1)}<span>%</span></p><h3>Less selection input</h3><p>Than the tested publicly available competitor.</p></div>
    <div><p class="jev-promo__proof-number">{number(comparison.totalRuns)}</p><h3>Benchmark runs recorded</h3><p>Across development, including unsuccessful attempts.</p></div>
  </div>
  <p class="jev-promo__proof-scope">Selection input: same independent <code>next_skill</code> confirmation, {confirmation.date}. Provider-reported input tokens, not whole-agent savings. The run count includes earlier revisions.</p>

  <details class="jev-promo__details" id="jev-feature-details">
    <summary>What you get — and how it compares with Hussi9</summary>
    <div class="jev-promo__details-body">
      <p><strong>Fast next-skill selection, with a broader advisor when you need it.</strong> Jev Session retains its HTTPS connection and search index. Its compact <code>next_skill</code> mode selects one skill; <code>general</code> also supports MCP tools and other outcomes. Hussi9’s complete router also supports MCP tools in its Codex variant.</p>
      <div class="jev-promo__table-scroll" role="region" aria-label="Product feature comparison" tabindex="0">
        <table>
          <caption>Product scope from source inspection · not a benchmark of every feature</caption>
          <thead><tr><th scope="col">Feature</th><th scope="col">Jev Capability Advisor</th><th scope="col">Hussi9 skill-router</th></tr></thead>
          <tbody>{initial.features.map((feature, index) => <tr><th scope="row">{feature.label}</th><td>{feature.value}</td><td>{comparison.allRows.find((row) => row.id === "hussi_original")!.features[index].value}</td></tr>)}</tbody>
        </table>
      </div>
      <ul>
        <li><strong>Less connection setup:</strong> a retained Jev Session reuses HTTPS. The published Hussi chooser opens a fresh connection in this measured path. Transport and provider effects were not isolated individually.</li>
        <li><strong>More task text:</strong> Jev permits 16,000 task characters. Hussi’s Jev chooser sends at most 600, plus up to 300 characters from the previous assistant message for tasks of 15 words or fewer. This is a request allowance, not the complete router’s input limit.</li>
        <li><strong>Different reuse:</strong> our measured path reuses transport and a derived search index, without cached answers. Hussi’s full router has a local index and saved decisions; those shortcuts and its fallback workflow are outside the chooser measurement.</li>
        <li><strong>The experiment:</strong> we connected Hussi’s selection function to our reusable HTTPS client and tested it with a fixed skill list. We did not integrate its inventory scan or MCP routing. The question marks mean “not checked or not used here”, not “Hussi cannot do this”. It is internal, unpublished and slightly faster in this cohort.</li>
      </ul>
      <p>Catalogs: Jev accepts the current inventory supplied by the host. Hussi can use its local index or supplied skill entries. The experiment used only the frozen benchmark entries.</p>
      <p><a href={comparison.hussiSource}>Pinned Hussi chooser source</a> · <a href={repoUrl(bench.readmePath) + "#product-features-and-measured-selection"}>Product-source references and technical notes</a></p>

      <p>Use <code>general</code> for skills, tools and experimental compound recommendations. Choose <code>next_skill</code> explicitly for one skill to load next; the rest of the task remains unassessed. Installing the skill does not install an automatic prompt hook.</p>
    </div>
  </details>

  <details class="jev-promo__details" id="jev-token-details">
    <summary>Token savings: the two head-to-head comparisons</summary>
    <div class="jev-promo__details-body"><JevNextSkillComparison comparison={nextSkill} /></div>
  </details>

  <details class="jev-promo__details" id="jev-speed-details">
    <summary>Speed comparison: full results &amp; how we measured</summary>
    <div class="jev-promo__details-body" id="jev-speed-method">
      <p>24 skill tasks and eight no-match tasks each ran twice, using the same frozen 132-entry catalog. Jev Session, published Hussi9 and our HTTPS experiment ran interleaved on {confirmation.date}; Native ran separately. All 48 skill observations per variant contribute to the displayed median, including incorrect accepted results. The 16 no-match observations are separate below.</p>
      <div class="jev-promo__table-scroll" role="region" aria-label="Complete next-skill results" tabindex="0">
        <table>
          <caption>Independent next-skill confirmation · 32 tasks × two repetitions · 64 observations per variant</caption>
          <thead><tr><th scope="col">Variant</th><th scope="col">Skill median</th><th scope="col">Skill p95</th><th scope="col">Correct accepted choices</th><th scope="col">No match correct</th><th scope="col">Errors</th></tr></thead>
          <tbody>{comparison.allRows.map((row) => <tr><th scope="row">{row.label}{row.experimental && " (internal, unpublished)"}</th><td>{row.medianSeconds.toFixed(6)} s</td><td>{row.p95Seconds.toFixed(6)} s</td><td>{row.correct}/{row.observations}</td><td>{row.noneCorrect}/{row.noneObservations}</td><td>{row.errors}</td></tr>)}</tbody>
        </table>
      </div>
      <ul>
        <li><strong>Same selection contract:</strong> same tasks, catalog and outcome grading. Native receives Jev’s exact next-skill cards and rules; Hussi retains its published chooser format and original 0.8 acceptance gate. Jev and Native select one next skill or no match; remaining work is unassessed. Hussi abstentions are not necessarily wrong raw guesses.</li>
        <li><strong>What is timed:</strong> selection preparation plus the model response. Session retains its process, HTTPS connection and index; no warmup, retries or decision cache. Process startup, skill loading and task execution are excluded.</li>
        <li><strong>Separate measurement windows:</strong> Jev/Hussi {comparison.jevWindow.started_at} – {comparison.jevWindow.summary_written_at}; Native {comparison.nativeWindow.started_at} – {comparison.nativeWindow.summary_written_at}. Provider load and prefix caching were uncontrolled; Native reported cached input in {comparison.nativeCachedTurns}/64 turns.</li>
        <li><strong>Native model:</strong> {comparison.nativeModel}, reasoning {comparison.nativeReasoning}. The requested configuration is recorded; backend identity is not independently observable. Jev variants use {comparison.jevModel}.</li>
      </ul>
      <p>Medians and factors use full recorded precision; p95 uses the same nearest-rank definition for all four variants. Native’s original handoff used an interpolated p95; its reported summaries remain in the evidence. The experiment is our modification, not a published Hussi9 release. Product-feature differences do not imply a benchmark of MCP or full-router workflows. These results describe this task set, not a complete market ranking or whole-task speedup.</p>
      <p><a href={repoUrl(comparison.evidencePath)}>Frozen Jev/Hussi evidence</a> · <a href={repoUrl(comparison.nativeEvidencePath)}>Native supplement and audit</a></p>
    </div>
  </details>

  <details class="jev-promo__details" id="jev-history-details">
    <summary>All {number(comparison.totalRuns)} runs &amp; earlier experiments</summary>
    <div class="jev-promo__details-body">
  <details class="jev-promo__details" id="jev-run-count">
    <summary>What counts as {number(comparison.totalRuns)} benchmark runs?</summary>
    <div class="jev-promo__details-body">
      <p>Completed benchmark executions across development revisions. Repeated tasks and comparison variants count as separate runs. This is not a count of unique tasks, passing tests or API requests.</p>
      <div class="jev-promo__table-scroll" role="region" aria-label="Benchmark run breakdown" tabindex="0">
        <table>
          <caption>Recorded development measurements</caption>
          <thead><tr><th scope="col">Experiment</th><th scope="col">Runs</th><th scope="col">Counted once</th></tr></thead>
          <tbody>{runs.map((run) => <tr><th scope="row">{run.label}</th><td>{number(run.count)}</td><td>{run.detail}</td></tr>)}</tbody>
          <tfoot><tr><th scope="row">Total</th><td>{number(comparison.totalRuns)}</td><td>Warmups, rescorings and assertions excluded</td></tr></tfoot>
        </table>
      </div>
    </div>
  </details>

      <details class="jev-promo__details">
        <summary>Earlier general-profile comparison · {history.dateLabel}</summary>
        <div class="jev-promo__details-body">
          <p>Different tasks and a different selection profile. These results are not used in the current factors.</p>
          <div class="jev-promo__table-scroll" role="region" aria-label="Historical general-profile results" tabindex="0"><table>
            <thead><tr><th scope="col">Variant</th><th scope="col">Skill median</th><th scope="col">Correct accepted choices</th></tr></thead>
            <tbody>{history.rows.map((row) => <tr><th scope="row">{row.label}</th><td>{row.medianSeconds.toFixed(3)} s</td><td>{row.correct}/{row.observations}</td></tr>)}</tbody>
          </table></div>
          <p><a href={repoUrl(history.evidencePath)}>Jev/Hussi evidence</a> · <a href={repoUrl(history.nativeEvidencePath)}>Native evidence</a></p>
        </div>
      </details>

      <section class="jev-promo__technical jev-promo__compact" aria-labelledby="jev-compact-title">
        <p class="jev-promo__label">Earlier optimization · 2026-09-23</p>
        <h3 id="jev-compact-title">{optimization.title}</h3>
        <p><strong>{optimization.reductionPercent.toFixed(1)}% lower median selection time</strong> across skills, MCP tools, clarification, no match and compound tasks in a {optimization.catalogRecords}-entry catalog. Same inputs and selection rules, reusable HTTPS in both variants.</p>
        <div class="jev-promo__table-scroll" role="region" aria-label="Session index results" tabindex="0">
          <table>
            <caption>Mixed selection · median · lower is better · 200 observations per variant</caption>
            <thead><tr><th scope="col">Variant</th><th scope="col">Median</th><th scope="col">Complete correct results</th><th scope="col">Errors</th></tr></thead>
            <tbody>{optimization.rows.map((row) => <tr><th scope="row">{row.label}</th><td>{row.median_ms.toFixed(0)} ms</td><td>{row.correct}/{row.n}</td><td>{row.errors}</td></tr>)}</tbody>
          </table>
        </div>
        <dl class="jev-promo__technical-mobile">
          {optimization.rows.map((row) => (
            <div><dt>{row.label}</dt><dd><strong>{row.median_ms.toFixed(0)} ms</strong>Median selection</dd><dd><strong>{row.correct}/{row.n} correct</strong>{row.errors} errors retained</dd></div>
          ))}
        </dl>
        <ul>{optimization.notes.map((note) => <li><strong>{note.title}.</strong> {note.text}</li>)}</ul>
        <p>The smaller skill-only catalog did not show the same total-speed benefit: Session was {optimization.smallCatalogChangePercent.toFixed(1)}% slower than our previous preparation, with 79/80 versus 80/80 accepted choices. Local preparation fell, while request time increased. These measurements do not establish the fastest skill overall.</p>
        <p class="jev-promo__technical-source"><a href={repoUrl(history.evidencePath)}>Both complete cohorts and paired intervals</a> · <a href={repoUrl(history.parityPath)}>Recorded-response equivalence</a></p>
      </section>

  <details class="jev-promo__details">
    <summary>Earlier native comparison: {bench.speedRatio.toFixed(2)}× faster median selection</summary>
    <div class="jev-promo__details-body">
      <div class="jev-promo__table-scroll" role="region" aria-label="Selection benchmark results" tabindex="0">
        <table>
          <caption>Earlier pre-session selection comparison · {bench.date}</caption>
          <thead><tr><th scope="col">Measure</th><th scope="col">Jev advisor</th><th scope="col">Native selector</th></tr></thead>
          <tbody>
            <tr><th scope="row">Median selection</th><td><strong>{bench.jev.medianSeconds.toFixed(3)} s</strong></td><td>{bench.native.medianSeconds.toFixed(3)} s</td></tr>
            <tr><th scope="row">p95 selection</th><td>{bench.jev.p95Seconds.toFixed(3)} s</td><td>{bench.native.p95Seconds.toFixed(3)} s</td></tr>
            <tr><th scope="row">Correct complete results</th><td>{bench.jev.correct}/{bench.tasks}</td><td>{bench.native.correct}/{bench.tasks}</td></tr>
          </tbody>
        </table>
      </div>
      <p>Both selectors received the same {bench.candidates} ordered cards per task from a {bench.catalogSize}-entry catalog. Task and arm order were randomized, with one sample per arm/task, no retries and no local caches. Provider caching and service load were uncontrolled.</p>
      <p>The headline is the ratio of medians. These are previously used synthetic regressions, not a fresh holdout. Single-task, no-match and clarification results tied at 58/60; compound results were 12/20 for Jev and 14/20 for native. All failures remain counted.</p>
      <p>Whole-host pilots have not shown faster task completion. Automatic prompt interception remains unqualified; the new session API is an integration building block. The cumulative run count covers earlier revisions too; it does not expand this earlier comparison beyond {bench.tasks} tasks.</p>
    </div>
  </details>

    </div>
  </details>

  <footer class="jev-promo__footer">
    <span>Release candidate · your agent controls loading and permissions</span>
    <div><a href={repoUrl(bench.readmePath)}>Benchmark README</a><a href={repoUrl(bench.methodsPath)}>Full evidence</a></div>
  </footer>
</section>

<script>
  const promo = document.querySelector<HTMLElement>("[data-jev-promo]");
  const chart = promo?.querySelector<HTMLElement>("[data-jev-chart]");
  const rows = Array.from(chart?.querySelectorAll<HTMLElement>("[data-jev-row]") ?? []);
  const defaultRow = rows.find((row) => row.dataset.jevRow === "jev_session");
  if (promo && chart && defaultRow) {
    const factor = promo.querySelector<HTMLElement>("[data-jev-factor]")!;
    const speedLabel = promo.querySelector<HTMLElement>("[data-jev-speed-label]")!;
    const label = promo.querySelector<HTMLElement>("[data-jev-comparison-label]")!;
    const description = promo.querySelector<HTMLElement>("[data-jev-comparison-description]")!;
    const quality = promo.querySelector<HTMLElement>("[data-jev-quality]")!;
    const score = promo.querySelector<HTMLElement>("[data-jev-score]")!;
    const features = Array.from(promo.querySelectorAll<HTMLElement>("[data-jev-feature]"));
    const featureIcons = features.map((feature) => feature.querySelector<HTMLElement>("[data-jev-feature-icon]")!);
    const featureStatuses: Record<string, string> = { supported: "Supported", unsupported: "Not supported", neutral: "Not checked or not used here" };
    const revealFeatures = () => featureIcons.forEach((icon) => { icon.dataset.revealed = "true"; });
    const announcement = promo.querySelector<HTMLElement>("[data-jev-announcement]")!;
    if ("IntersectionObserver" in window) {
      const revealScore = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.75) {
          score.dataset.revealed = "true";
          revealScore.disconnect();
        }
      }, { threshold: 0.75 });
      revealScore.observe(score);
      const featureObserver = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          revealFeatures();
          featureObserver.disconnect();
        }
      }, { threshold: 0.5 });
      featureObserver.observe(promo.querySelector("[data-jev-features]")!);
    } else {
      revealFeatures();
    }
    let selectedRow = defaultRow;
    const select = (requested: HTMLElement) => {
      const baseline = requested.dataset.factor === "";
      const row = baseline ? defaultRow : requested;
      if (row === selectedRow) return;
      selectedRow = row;
      factor.textContent = row.dataset.factor ?? "";
      speedLabel.textContent = row.dataset.speedLabel ?? "";
      label.textContent = `${row.dataset.label} vs native`;
      description.textContent = row.dataset.description ?? "";
      quality.textContent = row.dataset.quality ?? "";
      score.dataset.perfect = row.dataset.perfect;
      const selectedFeatures: { value: string; status: string }[] = JSON.parse(row.dataset.features!);
      features.forEach((feature, index) => {
        const selected = selectedFeatures[index];
        feature.dataset.status = selected.status;
        feature.querySelector<HTMLElement>("[data-jev-feature-value]")!.textContent = selected.value;
        const icon = featureIcons[index];
        icon.dataset.status = selected.status;
        icon.setAttribute("aria-label", featureStatuses[selected.status]);
        // Restart the short emphasis on a new variant, including after it settled.
        icon.getAnimations().forEach((animation) => { animation.cancel(); animation.play(); });
      });
      announcement.textContent = row.dataset.announcement ?? "";
      rows.filter((item) => item instanceof HTMLButtonElement).forEach((item) => item.setAttribute("aria-pressed", String(item === row)));
    };
