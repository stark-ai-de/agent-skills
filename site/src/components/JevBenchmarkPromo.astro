    observer.observe(promo);
  }
  document.querySelectorAll<HTMLAnchorElement>("a[data-jev-disclosure]").forEach((link) => {
    link.addEventListener("click", () => {
      const details = document.getElementById(link.dataset.jevDisclosure ?? "");
      if (details instanceof HTMLDetailsElement) details.open = true;
    });
  });
