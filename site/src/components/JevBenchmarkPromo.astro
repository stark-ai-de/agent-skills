      });
      entry.addEventListener("focusin", () => select(row));
      entry.addEventListener("click", () => select(row));
    });
    promo.querySelectorAll<HTMLElement>(".context-tip").forEach((tip) => {
      const card = tip.querySelector<HTMLElement>(".context-tip__card")!;
      const position = () => {
        const trigger = tip.getBoundingClientRect();
        tip.dataset.side = trigger.bottom + card.offsetHeight + 12 > window.innerHeight && trigger.top > card.offsetHeight + 16 ? "above" : "below";
      };
