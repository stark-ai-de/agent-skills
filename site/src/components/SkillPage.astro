---
import CommandBlock from "./CommandBlock.astro";
import OperationBadge from "./OperationBadge.astro";
import SkillFileTree from "./SkillFileTree.astro";
import type { CatalogSkill } from "../lib/skills";
import { collectionLabel, installHostLabel } from "../lib/skills";
import { withBase } from "../lib/site";

interface Props {
  skill: CatalogSkill;
}

const { skill } = Astro.props;
const indexHref = skill.kind === "public" ? "/skills/" : "/incubator/";
const defaultInstallHost = installHostLabel(skill.defaultInstallHost);
const targetRuntime = skill.targetRuntime ? installHostLabel(skill.targetRuntime) : undefined;
const contractLabel = targetRuntime ? `Target contract: ${targetRuntime}` : "Portable contract";
const supportedInstallHosts = skill.supportedInstallHosts.map(installHostLabel).join(", ");
const hasCrossHostInstalls = skill.supportedInstallHosts.length > 1;
const installHostLabelText = hasCrossHostInstalls
  ? "Supported install hosts"
  : "Supported install host";
const installSectionTitle =
  skill.kind === "public"
    ? hasCrossHostInstalls
      ? "Install hosts"
      : "Install host"
    : hasCrossHostInstalls
      ? "Local test hosts"
      : "Local test host";
const installContext = !targetRuntime
  ? "This portable, target-neutral contract can be installed into any supported execution host."
  : hasCrossHostInstalls
    ? `The ${targetRuntime} target contract stays unchanged when installed into another supported execution host.`
    : `This ${targetRuntime} target contract currently supports installation into ${defaultInstallHost} only.`;
---

<section class="skill-hero" data-reveal data-tracing-hero>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href={withBase("/")}>Catalog</a></li>
      <li><a href={withBase(indexHref)}>{collectionLabel(skill.kind)}</a></li>
      <li aria-current="page">{skill.title}</li>
    </ol>
  </nav>
  <p class="eyebrow">{skill.kind === "public" ? "Promoted public skill" : "Incubator candidate"}</p>
  <h1>{skill.title}</h1>
  <p>{skill.description}</p>
  <ul class="meta-pills" aria-label={`${skill.name} metadata`}>
    <OperationBadge label={skill.categoryLabel} tag="li" />
    {skill.version && <li>Version {skill.version}</li>}
    <li>{skill.license}</li>
    <li>{contractLabel}</li>
    <li>Default install host: {defaultInstallHost}</li>
    <li>{installHostLabelText}: {supportedInstallHosts}</li>
    {skill.hasOpenAiMetadata && <li>Codex/OpenAI metadata available</li>}
  </ul>
</section>

<div class="detail-layout" data-tracing-detail>
  <aside class="detail-panel" aria-label={`${skill.name} details`} data-tracing-sidebar>
    <section>
      <h2>Source</h2>
      <p>{skill.sourcePath}</p>
      <a href={skill.sourceUrl} rel="noreferrer" target="_blank">Open on GitHub</a>
    </section>
    <section class="detail-panel__command">
      <h2>{installSectionTitle}</h2>
      <p>{installContext}</p>
      {
        skill.installCommands.map(({ command, host }) => {
          const hostLabel = installHostLabel(host);
          const isDefault = host === skill.defaultInstallHost;
          const action = skill.kind === "public" ? "Install into" : "Test in";

          return (
            <div class="install-option">
              <p>
                <strong>{action} {hostLabel}{isDefault ? " (default)" : ""}</strong>
              </p>
              <CommandBlock
                command={command}
                iconOnly
                label={`${skill.name} ${action.toLowerCase()} ${hostLabel}`}
              />
            </div>
          );
        })
      }
    </section>
    {
      skill.evalUrl && (
        <section>
          <h2>Promotion proof</h2>
          <p>{skill.evalPath}</p>
          <a href={skill.evalUrl} rel="noreferrer" target="_blank">Open eval evidence</a>
        </section>
      )
    }
    {
      skill.openAiMetadataUrl && (
        <section>
          <h2>Agent metadata</h2>
          <p>{skill.openAiMetadataPath}</p>
          <a href={skill.openAiMetadataUrl} rel="noreferrer" target="_blank">Open metadata</a>
        </section>
      )
    }
    {
      skill.compatibility && (
        <section>
          <h2>Compatibility</h2>
          <p>{skill.compatibility}</p>
        </section>
      )
    }
    <SkillFileTree tree={skill.fileTree} />
  </aside>

  <article class="skill-content" data-tracing-content>
    <div class="markdown" set:html={skill.html} />
  </article>
</div>

<style>
  .install-option {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.8rem;
  }

  .install-option p {
    margin: 0;
  }
</style>
