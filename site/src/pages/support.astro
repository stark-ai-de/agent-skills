---
import CommandBlock from "../components/CommandBlock.astro";
import PolicyPage from "../components/PolicyPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getStarkAiDeveloperListing,
  pluginAddCommand,
  pluginMarketplaceAddCommand,
  standaloneSkillsInstallCommand,
} from "../lib/plugin-listing";
import { breadcrumbStructuredData, faqStructuredData, webPageStructuredData } from "../lib/seo";
import {
  absoluteSiteUrl,
  GITHUB_ISSUES_URL,
  GITHUB_REPO_URL,
  PLUGIN_PATH,
  SUPPORT_EMAIL,
  withBase,
} from "../lib/site";

const listing = getStarkAiDeveloperListing();
const marketplaceAddCommand = pluginMarketplaceAddCommand();
const pluginInstallCommand = pluginAddCommand(listing);
const skillsCliCommand = standaloneSkillsInstallCommand(listing);
const canonicalPath = "/support/";
const canonicalUrl = absoluteSiteUrl(canonicalPath);
const title = "Support";
const description =
  "Install help and issue reporting for the OpenAI plugin and this catalog. Do not include secrets in reports.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={[
    webPageStructuredData({
      canonicalUrl,
      description,
      mainEntityId: `${canonicalUrl}#faq`,
      title,
    }),
    breadcrumbStructuredData([
      { name: "Catalog", url: absoluteSiteUrl("/") },
      { name: title, url: canonicalUrl },
    ]),
    faqStructuredData({
      canonicalUrl,
      items: [
        {
          question: "How do I install the OpenAI plugin?",
          answer: `Codex 0.147.0 or later: run ${marketplaceAddCommand}, then ${pluginInstallCommand}. ChatGPT installs from the Plugins tab after directory publication.`,
        },
        {
          question: "How do I install the six skills without the plugin?",
          answer: `Use the skills CLI only when you want the catalog skills in a host, not the plugin. Run ${skillsCliCommand}.`,
        },
        {
          question: "What should a support report include?",
          answer:
            "Name the package version, skill, client and version, any host permission involved, what you expected, what actually happened (sanitized), and the smallest command that reproduces it. Do not include secrets, tokens, cookies, customer data, private repository paths, or internal hostnames.",
        },
        {
          question: "What can support not do?",
          answer:
            "Support cannot grant OpenAI account access, Apps Management permission, workspace publication, regional availability, or public-directory review status.",
        },
      ],
    }),
  ]}
>
  <PolicyPage
    currentPath={canonicalPath}
    eyebrow="Plugin and catalog"
    lead="Start with the plugin install commands. When you ask for help, include the client, version, and a sanitized reproduction. Do not send secrets."
    pills={["GitHub issues", SUPPORT_EMAIL]}
    title={title}
  >
    <a
      slot="actions"
      class="button button--primary button--signal"
      href={GITHUB_ISSUES_URL}
      rel="noreferrer"
      target="_blank"
    >
      <span>Open a GitHub issue</span>
    </a>
    <a slot="actions" class="button button--secondary" href={`mailto:${SUPPORT_EMAIL}`}>
      Email {SUPPORT_EMAIL}
    </a>
    <a slot="actions" class="button button--secondary" href={withBase("/security/")}>
      Report a security issue
    </a>

    <section slot="sidebar">
      <h2>Before reporting</h2>
      <p>
        Do not include secrets, tokens, cookies, customer data, private repository paths,
        internal hostnames, or private reviewer communication.
      </p>
    </section>

    <h2>Install the plugin</h2>
    <p>
      Codex and ChatGPT install the OpenAI plugin. That is not the skills CLI. Add this
      repository as a Codex marketplace, then install the plugin by name. After directory
      publication, ChatGPT can install it from the{" "}
      <a href="https://chatgpt.com/plugins" rel="noreferrer" target="_blank">Plugins</a> tab.
      The <a href={withBase(PLUGIN_PATH)}>plugin page</a> has the full walkthrough.
    </p>
    <CommandBlock command={marketplaceAddCommand} label="Add the plugin marketplace" />
    <CommandBlock command={pluginInstallCommand} label="Install the plugin" />

    <h2>Standalone skills</h2>
    <p>
      Use <code>npx skills</code> only when you want the six catalog skills in a host, not the
      plugin. The portable <code>plugins/stark-ai-developer/</code> tree is for clients that
      support that contract and for local testing. A <code>dist/openai</code> zip from{" "}
      <code>npm run package:openai-plugin</code> is a submission archive, not an install tree.
    </p>
    <CommandBlock command={skillsCliCommand} label="Install the six skills without the plugin" />

    <h2>What to include</h2>
    <p>
      Name the package version, skill, client and version, any host permission involved, what
      you expected, what actually happened (sanitized), and the smallest command that reproduces
      it. Say whether the problem is in a generated plugin copy or in the canonical skill.
    </p>

    <h2>For maintainers</h2>
    <p>
      Many packaging issues reproduce with the repository validators. Run the smallest relevant
      check before opening an issue.
    </p>
    <CommandBlock
      command="npm run validate:bundles && npm run validate:openai && npm run validate:projections && npm run validate:openai-plugin"
      label="Package validation commands"
    />

    <h2>What support cannot do</h2>
    <p>
      Support cannot grant OpenAI account access, Apps Management permission, workspace
      publication, regional availability, or public-directory review status. Those remain
      external gates. Source and documentation changes can be discussed in{" "}
      <a href={GITHUB_REPO_URL} rel="noreferrer" target="_blank">the repository</a>.
    </p>
  </PolicyPage>
</BaseLayout>
