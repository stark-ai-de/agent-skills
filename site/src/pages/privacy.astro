---
import PolicyPage from "../components/PolicyPage.astro";
import StarkAi from "../components/StarkAi.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbStructuredData, webPageStructuredData } from "../lib/seo";
import {
  absoluteSiteUrl,
  PUBLISHER_CITY,
  PUBLISHER_COUNTRY,
  PUBLISHER_LEGAL_NAME,
  PUBLISHER_LEGAL_NAME_FULL,
  PUBLISHER_PRIVACY_CONTROLLER,
  PUBLISHER_STREET,
  SECURITY_EMAIL,
  STARK_AI_PRIVACY_URL,
  SUPPORT_EMAIL,
  withBase,
} from "../lib/site";

const canonicalPath = "/privacy/";
const canonicalUrl = absoluteSiteUrl(canonicalPath);
const title = "Privacy policy";
const description =
  "The skills-only package does not send your prompts or files to stark AI. This notice covers the package and this catalog.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={[
    webPageStructuredData({ canonicalUrl, description, title }),
    breadcrumbStructuredData([
      { name: "Catalog", url: absoluteSiteUrl("/") },
      { name: title, url: canonicalUrl },
    ]),
  ]}
>
  <PolicyPage
    currentPath={canonicalPath}
    eyebrow="Package and catalog"
    pills={["Skills-only", "No package telemetry"]}
    title={title}
  >
    <p slot="lead">
      The skills-only package does not collect data for <StarkAi />. This notice covers the
      package, this catalog, and what stays with the host or GitHub.
    </p>
    <a slot="actions" class="button button--primary button--signal" href={withBase("/support/")}>
      <span>Contact support</span>
    </a>
    <a slot="actions" class="button button--secondary" href={withBase("/security/")}>
      Report a security issue
    </a>

    <h2>Who we are</h2>
    <p>
      {PUBLISHER_LEGAL_NAME} publishes this catalog and the{" "}
      <StarkAi text="stark AI Developer" /> package under the <StarkAi /> brand. For privacy
      questions, email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
    </p>
    <p>
      The responsible person is: {PUBLISHER_PRIVACY_CONTROLLER}. Provider:{" "}
      {PUBLISHER_LEGAL_NAME_FULL}, {PUBLISHER_STREET}, {PUBLISHER_CITY}, {PUBLISHER_COUNTRY}. See
      the <a href={withBase("/imprint/")}>Imprint</a> for full identification. The{" "}
      <a href={STARK_AI_PRIVACY_URL} rel="noreferrer" target="_blank">
        stark AI product website privacy notice
      </a>{" "}
      covers that marketing site, not this catalog.
    </p>

    <h2>What this notice covers</h2>
    <p>
      It covers the skills-only package and this static catalog. It does not describe processing
      by ChatGPT, Codex, Claude Code, Cursor, GitHub, GitHub Pages, an installer, or any other
      host, workspace, repository, or tool. Those services use their own notices.
    </p>

    <h2>The package</h2>
    <p>
      The package is Markdown skill instructions, OpenAI skill metadata, references, scripts,
      templates, and static assets. It has no backend, MCP server, connector, account system,
      authentication flow, telemetry, analytics, hidden network call, or runtime download.
    </p>
    <p>
      When a host uses a skill, that client or model may see the prompt, files, workspace
      metadata, command output, or other artifacts you make available. The package does not
      collect, keep, sell, profile, or transmit those categories on its own, and it does not
      send prompts, repositories, files, outputs, or credentials to <StarkAi />.
    </p>

    <h2>Answers for this package</h2>
    <p>
      These answers apply to the skills-only package. They do not describe a host product,
      GitHub, or this site's hosting provider.
    </p>
    <ul>
      <li>
        <strong>Personal data collected through the package:</strong> none.
      </li>
      <li>
        <strong>Purpose of processing by the package:</strong> none. The package does not
        independently collect, retain, sell, profile, or transmit user data.
      </li>
      <li>
        <strong>Who receives data from the package:</strong> no one.
      </li>
      <li>
        <strong>How long package data is kept:</strong> the package does not store personal
        data.
      </li>
      <li>
        <strong>Your controls:</strong> use <a href={withBase("/support/")}>Support</a> for
        ordinary questions and <a href={withBase("/security/")}>Security</a> for suspected
        vulnerabilities. Email{" "}
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> for privacy requests about this
        package or site.
      </li>
      <li>
        <strong>Host and product processing:</strong> ChatGPT, Codex, the selected host,
        workspace, repository, installer, and tools may process content under their own
        policies. This package cannot guarantee those processors.
      </li>
      <li>
        <strong>Accounts, backend, and telemetry:</strong> v1 has no <StarkAi /> account,
        backend, telemetry, analytics, or hidden network calls.
      </li>
      <li>
        <strong>Support and security reports:</strong> if you email us or open a GitHub report,
        we process the contact details and information you send only to respond, fix the issue,
        and keep a record of the report. Do not include secrets, tokens, customer data, or
        private infrastructure. Security reports go to{" "}
        <a href={`mailto:${SECURITY_EMAIL}`}>{SECURITY_EMAIL}</a> or GitHub private vulnerability
        reporting.
      </li>
    </ul>

    <h2>This catalog site</h2>
    <p>
      The catalog is a static site built from public repository files and hosted on GitHub
      Pages. We do not run analytics, advertising, or an account system on these pages. GitHub,
      GitHub Pages, and your browser may process HTTP requests, security logs, or similar
      technical data under GitHub's notices. We do not set GitHub's retention period,
      subprocessors, or transfer terms.
    </p>
  </PolicyPage>
</BaseLayout>
