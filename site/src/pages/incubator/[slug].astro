---
import SkillPage from "../../components/SkillPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  breadcrumbStructuredData,
  skillPageTitle,
  skillStructuredData,
  webPageStructuredData
} from "../../lib/seo";
import type { CatalogSkill } from "../../lib/skills";
import { getIncubatorSkills } from "../../lib/skills";
import { absoluteSiteUrl } from "../../lib/site";

interface Props {
  skill: CatalogSkill;
}

export async function getStaticPaths() {
  const skills = await getIncubatorSkills();

  return skills.map((skill) => ({
    params: {
      slug: skill.name
    },
    props: {
      skill
    }
  }));
}

const { skill } = Astro.props;
const canonicalPath = `/incubator/${skill.name}/`;
const canonicalUrl = absoluteSiteUrl(canonicalPath);
const pageTitle = skillPageTitle(skill);
const structuredData = [
  webPageStructuredData({
    canonicalUrl,
    dateModified: skill.modifiedAt,
    datePublished: skill.publishedAt,
    description: skill.description,
    mainEntityId: `${canonicalUrl}#article`,
    title: pageTitle
  }),
  breadcrumbStructuredData([
    { name: "Catalog", url: absoluteSiteUrl("/") },
    { name: "Incubator Skills", url: absoluteSiteUrl("/incubator/") },
    { name: skill.title, url: canonicalUrl }
  ]),
  skillStructuredData(skill, canonicalUrl)
];
---

<BaseLayout
  title={pageTitle}
  description={skill.description}
  canonicalPath={canonicalPath}
  imageAlt={`${skill.title} Incubator Skill catalog preview`}
  ogType="article"
  publishedTime={skill.publishedAt}
  modifiedTime={skill.modifiedAt}
  section={skill.categoryLabel}
  tags={[skill.name, skill.categoryLabel, "Incubator"]}
  structuredData={structuredData}
>
  <SkillPage skill={skill} />
</BaseLayout>
