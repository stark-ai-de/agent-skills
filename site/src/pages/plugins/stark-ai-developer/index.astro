---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getStarkAiDeveloperListing } from "../../../lib/plugin-listing";
import { breadcrumbStructuredData, webPageStructuredData } from "../../../lib/seo";
import { absoluteSiteUrl, GITHUB_REPO_URL, withBase } from "../../../lib/site";

const listing = getStarkAiDeveloperListing();
const { displayName, shortDescription, longDescription, capabilities } = listing.plugin;
const canonicalUrl = absoluteSiteUrl("/plugins/stark-ai-developer/");
const structuredData = [
  webPageStructuredData({
    canonicalUrl,
    description: longDescription,
    title: displayName,
  }),
  breadcrumbStructuredData([
    { name: "Catalog", url: absoluteSiteUrl("/") },
    { name: displayName, url: canonicalUrl },
  ]),
];
---

<BaseLayout
  title={displayName}
  description={longDescription}
  canonicalPath="/plugins/stark-ai-developer/"
  structuredData={structuredData}
>
  <section class="hero-section">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">{shortDescription}</p>
      <h1>{displayName}</h1>
      <p class="hero-copy__lead">{longDescription}</p>
      <div class="hero-actions">
        <a class="button button--primary button--signal" href={GITHUB_REPO_URL} target="_blank" rel="noreferrer">
          Review the source
        </a>
        <a class="button button--secondary" href={withBase("/support/")}>Get support</a>
      </div>
    </div>
    <aside class="hero-panel" aria-labelledby="plugin-boundary-title" data-reveal>
      <h2 id="plugin-boundary-title">Package boundary</h2>
      <p>
        This package contains reusable skill instructions and resources. It has no backend,
        MCP server, connectors, authentication, telemetry, analytics, hidden network calls,
        or runtime downloads.
      </p>
      <p class="section-note">
        Host, workspace, repository, and tool processing remain subject to the installing
        client's policies and capabilities.
      </p>
    </aside>
  </section>

  <section class="catalog-band" aria-labelledby="capabilities-title">
    <header class="section-heading">
      <p>One explicit six-skill bundle</p>
      <h2 id="capabilities-title">Built for the full developer workflow</h2>
    </header>
    <div class="skill-grid">
      {
        capabilities.map((capability) => (
          <article class="skill-card">
            <p>{capability}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="source-band" aria-labelledby="distribution-title">
    <div>
      <p class="eyebrow">Distribution boundaries</p>
      <h2 id="distribution-title">Local catalogs are not public publication</h2>
      <p>
        The repository-local marketplace is a portable Agent Plugins testing catalog. The
        OpenAI-native archive is generated from ephemeral adapter staging at package time and is
        not a committed repository tree. A successful local install,
        GitHub release, or workspace marketplace entry does not mean that the plugin is
        approved, searchable, or published in the Universal Plugins Directory.
      </p>
    </div>
    <div class="hero-actions">
      <a class="button button--secondary" href={withBase("/privacy/")}>Privacy draft</a>
      <a class="button button--secondary" href={withBase("/terms/")}>Terms draft</a>
    </div>
  </section>
</BaseLayout>
