---
import CommandBlock from "../../../components/CommandBlock.astro";
import ContextTooltip from "../../../components/ContextTooltip.astro";
import HeroLogo from "../../../components/HeroLogo.astro";
import SkillCard from "../../../components/SkillCard.astro";
import StarkAi from "../../../components/StarkAi.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getStarkAiDeveloperListing,
  pluginAddCommand,
  pluginMarketplaceAddCommand,
  resolvePluginCatalogSkills,
  standaloneSkillsInstallCommand,
} from "../../../lib/plugin-listing";
import {
  breadcrumbStructuredData,
  howToStructuredData,
  pluginSoftwareStructuredData,
  skillListStructuredData,
  webPageStructuredData,
} from "../../../lib/seo";
import { getPublicSkills } from "../../../lib/skills";
import {
  absoluteSiteUrl,
  GITHUB_REPO_URL,
  PLUGIN_PATH,
  PLUGIN_SEO_DESCRIPTION,
  withBase,
  withStarkAi,
} from "../../../lib/site";

const listing = getStarkAiDeveloperListing();
const {
  displayName,
  longDescription,
  capabilities,
  starterPrompts,
  version,
} = listing.plugin;
const bundledSkills = resolvePluginCatalogSkills(listing, await getPublicSkills());
const marketplaceAddCommand = pluginMarketplaceAddCommand();
const pluginInstallCommand = pluginAddCommand(listing);
const skillsCliCommand = standaloneSkillsInstallCommand(listing);
const canonicalUrl = absoluteSiteUrl(PLUGIN_PATH);
const pluginName = withStarkAi(displayName);
const description = PLUGIN_SEO_DESCRIPTION;
const structuredData = [
  webPageStructuredData({
    canonicalUrl,
    description,
    mainEntityId: `${canonicalUrl}#software`,
    title: `${pluginName} plugin`,
    type: "CollectionPage",
  }),
  breadcrumbStructuredData([
    { name: "Catalog", url: absoluteSiteUrl("/") },
    { name: pluginName, url: canonicalUrl },
  ]),
  pluginSoftwareStructuredData({
    canonicalUrl,
    description,
    name: pluginName,
    version,
  }),
  howToStructuredData({
    canonicalUrl,
    description: "Add this repository as a Codex marketplace, then install the plugin by name.",
    name: `Install ${pluginName}`,
    steps: [
      { name: "Add the Codex marketplace", text: marketplaceAddCommand },
      { name: "Install the plugin", text: pluginInstallCommand },
    ],
  }),
  skillListStructuredData(bundledSkills, canonicalUrl),
];
---

<BaseLayout
  title={`${displayName} plugin`}
  description={description}
  canonicalPath={PLUGIN_PATH}
  structuredData={structuredData}
>
  <section class="hero-section">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">OpenAI skills-only plugin</p>
      <h1><StarkAi text={displayName} /></h1>
      <p class="hero-copy__lead">{longDescription}</p>
      <div class="hero-actions">
        <a class="button button--primary button--signal" href="#install">
          <span>Install the plugin</span>
        </a>
        <a class="button button--secondary" href={GITHUB_REPO_URL} rel="noreferrer" target="_blank">
          Review the source
        </a>
      </div>
    </div>
    <div class="hero-brand" data-reveal aria-hidden="true">
      <HeroLogo />
    </div>
    <aside class="hero-panel" aria-labelledby="plugin-summary-title" data-reveal>
      <h2 class="sr-only" id="plugin-summary-title">Package summary and plugin install command</h2>
      <dl>
        <div>
          <dt>
            Skills
            <ContextTooltip
              align="start"
              id="plugin-skills-tip"
              label="Bundled skills"
              text="This plugin ships exactly six public catalog skills as one explicit developer toolkit."
            />
          </dt>
          <dd>{bundledSkills.length}</dd>
        </div>
        <div>
          <dt>
            Surface
            <ContextTooltip
              id="plugin-surface-tip"
              label="Skills-only"
              text="The plugin has no backend, MCP server, connectors, authentication, telemetry, analytics, hidden network calls, or runtime downloads."
            />
          </dt>
          <dd>Skills-only</dd>
        </div>
        <div>
          <dt>
            Version
            <ContextTooltip
              align="end"
              id="plugin-version-tip"
              label="Plugin version"
              text="Plugin identity is independent of the catalog repository version."
            />
          </dt>
          <dd>v{version}</dd>
        </div>
      </dl>
      <CommandBlock command={marketplaceAddCommand} label="Add the plugin marketplace" />
    </aside>
  </section>

  <section class="catalog-band" aria-labelledby="plugin-skills-title">
    <header class="section-heading">
      <p>Bundled in the plugin</p>
      <h2 id="plugin-skills-title">Six developer workflows</h2>
      <a href={withBase("/skills/")}>View all public skills</a>
    </header>
    <div class="skill-grid">
      {bundledSkills.map((skill) => <SkillCard skill={skill} compact />)}
    </div>
  </section>

  <section class="catalog-band catalog-band--muted" aria-labelledby="capabilities-title">
    <header class="section-heading">
      <p>What the plugin is for</p>
      <h2 id="capabilities-title">What you can ask it to do</h2>
    </header>
    <div class="skill-grid">
      {
        capabilities.map((capability) => (
          <article class="skill-card skill-card--compact skill-card--text" data-reveal>
            <p>{capability}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="catalog-band catalog-band--flush" aria-labelledby="starter-prompts-title">
    <header class="section-heading">
      <p>Try these first</p>
      <h2 id="starter-prompts-title">Starter prompts</h2>
    </header>
    <div class="skill-grid">
      {
        starterPrompts.map((prompt, index) => (
          <div data-reveal>
            <CommandBlock
              command={prompt}
              kind="prompt"
              label={`Starter prompt ${index + 1}`}
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="catalog-band" aria-labelledby="install-heading" id="install">
    <header class="section-heading">
      <p>ChatGPT and Codex</p>
      <h2 id="install-heading">Install the plugin</h2>
    </header>
    <p class="section-note">
      ChatGPT and Codex will share one public plugin listing after publication. Until then, add
      this repository as a Codex marketplace and install the plugin by name. A local install or
      GitHub release is not that listing. Copying skills with the skills CLI does not install
      the plugin. The installing client still applies its own policies to your workspace and
      tools.
    </p>
    <div class="install-stack">
      <div>
        <h3>Codex CLI</h3>
        <p>
          Codex 0.147.0 or later. Add the repository marketplace, then install{" "}
          <code>{listing.plugin.name}</code>. If more than one marketplace uses that name, pass{" "}
          <code>--marketplace</code> with the name from{" "}
          <code>codex plugin marketplace list</code>. In an interactive Codex session you can
          also run <code>/plugins</code>.
        </p>
        <CommandBlock command={marketplaceAddCommand} label="Add the plugin marketplace" />
        <CommandBlock command={pluginInstallCommand} label="Install the plugin" />
      </div>
      <div>
        <h3>ChatGPT</h3>
        <p>
          Open the{" "}
          <a href="https://chatgpt.com/plugins" rel="noreferrer" target="_blank">Plugins</a>{" "}
          tab, search for <StarkAi text={displayName} />, and install. After directory
          publication, that listing is shared with Codex.
        </p>
      </div>
      <div class="install-stack--secondary">
        <h3>Standalone skills CLI</h3>
        <p>
          Use this only when you want the six workflows as separate catalog skills, not as the
          plugin. <code>npx skills</code> copies <code>SKILL.md</code> trees into a host. It
          does not add a ChatGPT or Codex plugin.
        </p>
        <CommandBlock command={skillsCliCommand} label="Install the six skills without the plugin" />
      </div>
    </div>
  </section>
</BaseLayout>
