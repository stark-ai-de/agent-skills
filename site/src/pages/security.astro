---
import PolicyPage from "../components/PolicyPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbStructuredData, webPageStructuredData } from "../lib/seo";
import {
  absoluteSiteUrl,
  GITHUB_REPO_URL,
  GITHUB_SECURITY_ADVISORIES_URL,
  GITHUB_SECURITY_POLICY_URL,
  SECURITY_EMAIL,
  withBase,
} from "../lib/site";

const canonicalPath = "/security/";
const canonicalUrl = absoluteSiteUrl(canonicalPath);
const title = "Security";
const description =
  "Report suspected vulnerabilities privately by GitHub advisory or email. Do not file public issues for security problems.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={[
    webPageStructuredData({ canonicalUrl, description, title }),
    breadcrumbStructuredData([
      { name: "Catalog", url: absoluteSiteUrl("/") },
      { name: title, url: canonicalUrl },
    ]),
  ]}
>
  <PolicyPage
    currentPath={canonicalPath}
    eyebrow="Private vulnerability reporting"
    lead="Use a private channel for suspected vulnerabilities, credential exposure, or harmful package behavior. Do not disclose sensitive details in a public issue."
    pills={["Private reports", SECURITY_EMAIL]}
    title={title}
  >
    <a
      slot="actions"
      class="button button--primary button--signal"
      href={GITHUB_SECURITY_POLICY_URL}
      rel="noreferrer"
      target="_blank"
    >
      <span>Read the security policy</span>
    </a>
    <a slot="actions" class="button button--secondary" href={`mailto:${SECURITY_EMAIL}`}>
      Email {SECURITY_EMAIL}
    </a>
    <a slot="actions" class="button button--secondary" href={withBase("/support/")}>
      Support
    </a>

    <section slot="sidebar">
      <h2>Report privately</h2>
      <p>GitHub private vulnerability reporting is preferred when you have a GitHub account.</p>
      <nav class="policy-links" aria-label="Security reporting routes">
        <a href={GITHUB_SECURITY_ADVISORIES_URL} rel="noreferrer" target="_blank">
          Open a private advisory
        </a>
        <a href={`mailto:${SECURITY_EMAIL}`}>{SECURITY_EMAIL}</a>
      </nav>
    </section>

    <h2>What this covers</h2>
    <p>
      Report issues in the skills-only package or this catalog: suspected vulnerabilities,
      credential exposure, unsafe scripts, or harmful package behavior. The package is Markdown
      skills and static assets. It has no backend, MCP server, connectors, authentication,
      telemetry, analytics, hidden network calls, or runtime downloads.
    </p>

    <h2>How to report</h2>
    <p>
      Follow the repository{" "}
      <a href={GITHUB_SECURITY_POLICY_URL} rel="noreferrer" target="_blank">security policy</a>
      {" "}and use GitHub private vulnerability reporting when you can. Email{" "}
      <a href={`mailto:${SECURITY_EMAIL}`}>{SECURITY_EMAIL}</a> if you cannot use GitHub.
    </p>
    <p>
      Include the affected version or commit, whether a plugin copy or archive is involved, the
      skill or path, the impact, steps to reproduce, and a sanitized proof. If a public URL,
      marketplace entry, or portal artifact is involved, say whether it is local, draft,
      external, or verified. Do not imply a stronger status.
    </p>

    <h2>What not to include</h2>
    <p>
      Do not send secrets, live credentials, customer data, private repository paths, or exploit
      payloads that are unnecessary to understand the issue. Do not open a public issue for a
      suspected vulnerability.
    </p>

    <h2>Ordinary bugs</h2>
    <p>
      Install, documentation, and source questions that are not security issues belong on{" "}
      <a href={withBase("/support/")}>Support</a> or{" "}
      <a href={GITHUB_REPO_URL} rel="noreferrer" target="_blank">GitHub</a>.
    </p>
  </PolicyPage>
</BaseLayout>
