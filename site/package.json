{
  "name": "agent-skills-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun exec \"bun --bun scripts/test-site-build.mjs && bun --bun scripts/test-jev-benchmarks.mjs && bun --bun astro build && bun --bun scripts/validate-seo.mjs\"",
    "dev": "bun --bun astro dev",
    "preview": "bun --bun astro preview",
    "validate:seo": "bun --bun scripts/validate-seo.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.3",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^7.0.2"
  }
}
