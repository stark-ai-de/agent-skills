{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stark-ai.de/schemas/stark-ai-developer.source.schema.json",
  "title": "stark AI Developer plugin source",
  "description": "Author-maintained membership and plugin identity for the generated stark-ai-developer package. Generated plugin.json files use the official Agent Plugins 1.0.0 schema separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "skills",
    "distributions",
    "pluginId",
    "version",
    "listingId",
    "submissionType",
    "publicListingStrategy",
    "outputs",
    "contractSnapshots",
    "build"
  ],
  "properties": {
    "$schema": {
      "const": "./stark-ai-developer.source.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "source": {
            "type": "string",
            "pattern": "^skills/[a-z0-9-]+/[a-z0-9-]+$"
          }
        }
      }
    },
    "distributions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillsCliAgent", "portablePlugin", "openaiPlugin"],
      "properties": {
        "skillsCliAgent": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "portablePlugin": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "openaiPlugin": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "listingId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "submissionType": {
      "const": "skills-only"
    },
    "publicListingStrategy": {
      "const": "single-plugin-six-bundled-skills"
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portableProjection", "openaiArchive", "repositoryMarketplaceTarget"],
      "properties": {
        "portableProjection": {
          "const": "plugins/stark-ai-developer"
        },
        "openaiArchive": {
          "type": "string",
          "pattern": "^dist/openai/[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]+\\.[0-9]+\\.[0-9]+\\.zip$"
        },
        "repositoryMarketplaceTarget": {
          "const": "plugins/stark-ai-developer"
        }
      }
    },
    "contractSnapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentPlugins", "openaiPackaging", "openaiSubmission"],
      "properties": {
        "agentPlugins": {
          "type": "string",
          "minLength": 1
        },
        "openaiPackaging": {
          "type": "string",
          "minLength": 1
        },
        "openaiSubmission": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "pnpmVersion", "archiveProfile"],
      "properties": {
        "nodeVersion": {
          "const": "24.18.0"
        },
        "pnpmVersion": {
          "const": "11.22.0"
        },
        "archiveProfile": {
          "const": "zip-store-v1"
        }
      }
    }
  }
}
