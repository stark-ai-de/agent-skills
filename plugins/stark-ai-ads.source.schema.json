{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent stark AI Ads plugin source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "name",
    "version",
    "displayName",
    "shortDescription",
    "description",
    "author",
    "category",
    "capabilities",
    "starterPrompts",
    "urls",
    "assets",
    "skill",
    "oauthClientId",
    "output",
    "contractVerifiedOn"
  ],
  "properties": {
    "$schema": { "const": "./stark-ai-ads.source.schema.json" },
    "schemaVersion": { "const": 1 },
    "name": { "const": "stark-ai-ads" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 30 },
    "shortDescription": { "type": "string", "minLength": 1, "maxLength": 30 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": { "const": "Business & Operations" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "starterPrompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["website", "privacyPolicy", "termsOfService", "support"],
      "properties": {
        "website": { "$ref": "#/$defs/url" },
        "privacyPolicy": { "$ref": "#/$defs/url" },
        "termsOfService": { "$ref": "#/$defs/url" },
        "support": { "$ref": "#/$defs/url" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logo", "logoDark", "composerIcon", "composerIconDark"],
      "properties": {
        "logo": { "type": "string", "minLength": 1 },
        "logoDark": { "type": "string", "minLength": 1 },
        "composerIcon": { "type": "string", "minLength": 1 },
        "composerIconDark": { "type": "string", "minLength": 1 }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": { "const": "openai-advertiser-api" },
        "source": { "const": "skills/engineering-workflows/openai-advertiser-api" }
      }
    },
    "oauthClientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "output": {
      "type": "string",
      "pattern": "^dist/openai/stark-ai-ads-[0-9]+\\.[0-9]+\\.[0-9]+\\.zip$"
    },
    "contractVerifiedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  },
  "$defs": {
    "url": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^https://" }
  }
}
