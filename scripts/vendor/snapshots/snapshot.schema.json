{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stark-ai.de/schemas/contract-snapshot.schema.json",
  "title": "External contract snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "source",
    "verifiedOn",
    "verifiedBy",
    "precedenceClass",
    "facts",
    "requirementIds",
    "validators",
    "unresolvedConflicts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "checksum"],
      "properties": {
        "url": { "type": "string", "minLength": 8 },
        "title": { "type": "string", "minLength": 1 },
        "checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "verifiedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verifiedBy": { "type": "string", "minLength": 1 },
    "precedenceClass": {
      "enum": [
        "machine-schema",
        "product-surface",
        "packaging-submission",
        "help-center",
        "changelog-historical"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": true
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolvedConflicts": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
