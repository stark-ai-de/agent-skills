{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Skills bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "skills",
    "distributions"
  ],
  "properties": {
    "$schema": {
      "const": "./bundle.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "source": {
            "type": "string",
            "pattern": "^skills/[a-z0-9-]+/[a-z0-9-]+$"
          }
        }
      }
    },
    "distributions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillsCliAgent",
        "portablePlugin",
        "openaiPlugin"
      ],
      "properties": {
        "skillsCliAgent": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "portablePlugin": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "openaiPlugin": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    }
  }
}
