def redact(text):
    return str(text or "").replace(str(Path.home()), "~")


def short(text, limit=8000):
    value = redact(text)
    return value if len(value) <= limit else f"{value[:limit]}..."


def as_text(value):
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value)


PROMPT_ECHO_MARKER = "[redacted-prompt]"
PROMPT_ECHO_SEED_CHARS = 16
PROMPT_ECHO_MAX_UNIQUE_SEEDS = 65_536
PROMPT_ECHO_MAX_SPANS = 65_536
PROMPT_ECHO_BOUNDARY_CONTEXT_BYTES = PROMPT_ECHO_SEED_CHARS * 4
MAX_STDOUT_CAPTURE_BYTES = 10 * 1024 * 1024
MAX_STDERR_CAPTURE_BYTES = 64 * 1024
CAPTURE_CHUNK_BYTES = 64 * 1024
OUTPUT_TRUNCATION_MARKER = "[output truncated; retained tail]"


class BoundedCaptureError(OSError):
    pass


class BoundedByteCapture:
    def __init__(self, limit):
        self.limit = max(1, int(limit))
        self._chunks = deque()
        self._retained_bytes = 0
        self._total_bytes = 0
        self._discarded_tail = b""
        self._lock = Lock()

    def _remember_discarded(self, value):
        recent = value[-PROMPT_ECHO_BOUNDARY_CONTEXT_BYTES:]
        self._discarded_tail = (
            self._discarded_tail + recent
        )[-PROMPT_ECHO_BOUNDARY_CONTEXT_BYTES:]

    def append(self, chunk):
        value = bytes(chunk or b"")
        if not value:
            return
        with self._lock:
            self._total_bytes += len(value)
            self._chunks.append(value)
            self._retained_bytes += len(value)
            while self._retained_bytes > self.limit:
                excess = self._retained_bytes - self.limit
                first = self._chunks[0]
                if len(first) <= excess:
                    removed = self._chunks.popleft()
                    self._retained_bytes -= len(first)
                else:
                    removed = first[:excess]
                    self._chunks[0] = first[excess:]
                    self._retained_bytes -= excess
                self._remember_discarded(removed)

    @property
    def total_bytes(self):
        with self._lock:
            return self._total_bytes

    def snapshot(self):
        with self._lock:
            return b"".join(self._chunks), self._total_bytes > self.limit

    def redaction_snapshot(self):
        with self._lock:
            return (
                self._discarded_tail,
                b"".join(self._chunks),
                self._total_bytes > self.limit,
            )


class BoundedProcessIO:
    def __init__(
        self,
        process,
        prompt,
        stdout_limit=MAX_STDOUT_CAPTURE_BYTES,
        stderr_limit=MAX_STDERR_CAPTURE_BYTES,
    ):
        self.process = process
        self.prompt = str(prompt or "").encode("utf-8", errors="replace")
        self.stdout = BoundedByteCapture(stdout_limit)
        self.stderr = BoundedByteCapture(stderr_limit)
        self._errors = []
        self._error_lock = Lock()
        self._readers = [
            Thread(
                target=self._read_stream,
                args=("stdout", process.stdout, self.stdout),
                name="skillopt-stdout-drain",
                daemon=True,
            ),
            Thread(
                target=self._read_stream,
                args=("stderr", process.stderr, self.stderr),
                name="skillopt-stderr-drain",
                daemon=True,
            ),
        ]
        self._writer = Thread(
            target=self._write_prompt,
            name="skillopt-stdin-writer",
            daemon=True,
        )
        self._threads = [*self._readers, self._writer]
        self._started_threads = []

    def _record_error(self, label, error):
        with self._error_lock:
            self._errors.append(f"{label}: {type(error).__name__}")

    def _read_stream(self, label, stream, capture):
        try:
            while True:
                chunk = stream.read(CAPTURE_CHUNK_BYTES)
                if not chunk:
                    return
                capture.append(chunk)
        except Exception as error:
            self._record_error(label, error)
        finally:
            try:
                stream.close()
            except Exception:
                pass

    def _write_prompt(self):
        stream = self.process.stdin
        try:
            view = memoryview(self.prompt)
            while view:
                written = stream.write(view)
                if not written:
                    raise BrokenPipeError("stdin closed before prompt transport completed")
                view = view[written:]
            stream.flush()
        except BrokenPipeError:
            pass
        except OSError as error:
            if error.errno not in {errno.EINVAL, errno.EPIPE}:
                self._record_error("stdin", error)
        except Exception as error:
            self._record_error("stdin", error)
        finally:
            try:
                stream.close()
            except Exception:
                pass

    def start(self):
        for thread in self._threads:
            try:
                thread.start()
            finally:
                if thread.ident is not None and thread not in self._started_threads:
                    self._started_threads.append(thread)

    def close_unstarted_streams(self):
        thread_streams = (
            (self._readers[0], self.process.stdout),
            (self._readers[1], self.process.stderr),
            (self._writer, self.process.stdin),
        )
        for thread, stream in thread_streams:
            if thread in self._started_threads or thread.is_alive():
                continue
            try:
                stream.close()
            except Exception:
                pass

    def close_stopped_streams(self):
        thread_streams = (
            (self._readers[0], self.process.stdout),
            (self._readers[1], self.process.stderr),
            (self._writer, self.process.stdin),
        )
        for thread, stream in thread_streams:
            if thread.is_alive():
                continue
            try:
                stream.close()
            except Exception:
                pass

    def finish(self, timeout=7):
        deadline = time.monotonic() + max(0, timeout)
        for thread in self._started_threads:
            thread.join(timeout=max(0, deadline - time.monotonic()))
        alive = [thread.name for thread in self._started_threads if thread.is_alive()]
        if alive:
            raise BoundedCaptureError("bounded subprocess I/O threads did not stop")
        with self._error_lock:
            errors = list(self._errors)
        if errors:
            raise BoundedCaptureError("bounded subprocess I/O failed: " + "; ".join(errors))


def render_captured_stream(capture, prompt):
    discarded_tail, payload, truncated = capture.redaction_snapshot()
    value = payload.decode("utf-8", errors="replace")
    boundary_chars = prompt_boundary_prefix_chars(
        discarded_tail,
        payload,
        str(prompt or "").encode("utf-8", errors="replace"),
    )
    value = redact_prompt(value, prompt, boundary_chars=boundary_chars)
    if truncated:
        return f"{OUTPUT_TRUNCATION_MARKER}\n{value}"
    return value


def prompt_boundary_prefix_chars(discarded_tail, payload, transported):
    """Return retained leading characters proven to continue a discarded prompt echo."""
    if not discarded_tail or not payload or len(transported) < 2:
        return 0
    seed_bytes = min(PROMPT_ECHO_SEED_CHARS, len(transported))
    max_left_size = min(seed_bytes - 1, len(discarded_tail))
    if max_left_size <= 0:
        return 0
    high = min(len(payload), PROMPT_ECHO_BOUNDARY_CONTEXT_BYTES)
    matched_bytes = 0
    for left_size in range(1, max_left_size + 1):
        left = discarded_tail[-left_size:]
        if left + payload[:1] not in transported:
            continue
        low = 1
        candidate_high = high
        while low < candidate_high:
            middle = (low + candidate_high + 1) // 2
            if left + payload[:middle] in transported:
                low = middle
            else:
                candidate_high = middle - 1
        matched_bytes = max(matched_bytes, low)
        if matched_bytes == high:
            break
    return len(payload[:matched_bytes].decode("utf-8", errors="replace"))


def prompt_echo_spans(value, transported):
    """Return bounded prompt-derived spans, or None to request fail-closed redaction."""
    spans = []
    if not value or not transported:
        return spans

    # A short captured stream or an individual line can be a truncated stdin echo.
    # Treat it as sensitive even when it is shorter than the rolling-match seed.
    if value in transported:
        return [(0, len(value))]
    for match in re.finditer(r"[^\r\n]+", value):
        line = match.group(0)
        stripped = line.strip()
        if stripped and stripped in transported:
            offset = line.find(stripped)
            spans.append((match.start() + offset, match.start() + offset + len(stripped)))
            if len(spans) > PROMPT_ECHO_MAX_SPANS:
                return None

    seed_size = min(PROMPT_ECHO_SEED_CHARS, len(transported))
    if seed_size <= 0 or len(value) < seed_size:
        return spans

    prompt_seeds = set()
    for index in range(len(transported) - seed_size + 1):
        prompt_seeds.add(transported[index : index + seed_size])
        if len(prompt_seeds) > PROMPT_ECHO_MAX_UNIQUE_SEEDS:
            return None

    seed_spans = []
    last_seed_start = len(value) - seed_size
    for index in range(last_seed_start + 1):
        if value[index : index + seed_size] not in prompt_seeds:
            continue
        end = index + seed_size
        if seed_spans and index <= seed_spans[-1][1]:
            seed_spans[-1] = (
                seed_spans[-1][0],
                max(seed_spans[-1][1], end),
            )
        else:
            seed_spans.append((index, end))
            if len(spans) + len(seed_spans) > PROMPT_ECHO_MAX_SPANS:
                return None
    spans.extend(seed_spans)
    return spans


def redact_prompt(text, prompt, boundary_chars=0):
    value = as_text(text)
    transported = str(prompt or "").encode("utf-8", errors="replace").decode("utf-8")
    spans = prompt_echo_spans(value, transported)
    if spans is None:
        return PROMPT_ECHO_MARKER if value else ""
    guard_end = min(len(value), max(0, int(boundary_chars)))
    if guard_end:
        if len(spans) >= PROMPT_ECHO_MAX_SPANS:
            return PROMPT_ECHO_MARKER
        spans.append((0, guard_end))
    if not spans:
        return value
    spans.sort()
    merged = []
    for start, end in spans:
        if merged and start <= merged[-1][1]:
            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
        else:
            merged.append((start, end))
    parts = []
    cursor = 0
    for start, end in merged:
        parts.extend((value[cursor:start], PROMPT_ECHO_MARKER))
        cursor = end
    parts.append(value[cursor:])
    return "".join(parts)


def redact_timeout_stream(text):
    # Once transport is interrupted, even a one-character captured fragment can
    # be prompt-derived. Its ownership cannot be distinguished from diagnostics.
    return PROMPT_ECHO_MARKER if as_text(text) else ""


