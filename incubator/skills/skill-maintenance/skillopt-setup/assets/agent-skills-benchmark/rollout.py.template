class ArtifactPolicyError(ValueError):
    pass


class ProviderContextError(ValueError):
    pass


def path_is_within(path, root):
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def codex_runtime_read_path(command):
    candidate = Path(str(command or "codex")).expanduser()
    if not candidate.is_absolute():
        resolved_command = shutil.which(str(candidate))
        if not resolved_command:
            return None
        candidate = Path(resolved_command)
    try:
        executable = candidate.resolve(strict=True)
    except OSError:
        return None

    runtime_path = executable
    for parent in executable.parents:
        package_json = parent / "package.json"
        if not package_json.is_file():
            continue
        try:
            package = json.loads(package_json.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        package_name = str(package.get("name") or "")
        if package_name == "@openai/codex" or package_name.startswith("@openai/codex-"):
            runtime_path = parent
            break

    forbidden_roots = [(Path.home() / ".codex").resolve()]
    if os.environ.get("CODEX_HOME"):
        forbidden_roots.append(Path(os.environ["CODEX_HOME"]).expanduser().resolve())
    if runtime_path == Path(runtime_path.anchor) or runtime_path == Path.home():
        return None
    if any(path_is_within(runtime_path, root) for root in forbidden_roots):
        return None
    return runtime_path


def drawio_runtime_read_path(command):
    executable = Path(command).resolve(strict=True)
    for parent in executable.parents:
        name = parent.name.lower()
        if "drawio" in name or "draw.io" in name or "diagrams" in name:
            return parent
    return executable


def visual_rollout_filesystem_permissions(codex_command, drawio_cli=None):
    entries = [
        '":minimal"="read"',
        (
            '":workspace_roots"={"."="write",'
            f'"{ROLLOUT_CONTROL_DIR}"="deny"'
            "}"
        ),
    ]
    runtime_path = codex_runtime_read_path(codex_command)
    if runtime_path is not None:
        entries.append(f"{toml_string(runtime_path)}=\"read\"")
    if drawio_cli:
        entries.append(f"{toml_string(drawio_runtime_read_path(drawio_cli))}=\"read\"")
    return "{" + ",".join(entries) + "}"


def text_rollout_filesystem_permissions(codex_command):
    entries = [
        '":minimal"="read"',
        (
            '":workspace_roots"={"."="deny",'
            f'"{ROLLOUT_CONTROL_DIR}"="deny"'
            "}"
        ),
    ]
    runtime_path = codex_runtime_read_path(codex_command)
    if runtime_path is not None:
        entries.append(f"{toml_string(runtime_path)}=\"read\"")
