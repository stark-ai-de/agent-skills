def safe_rmtree(path):
    try:
        shutil.rmtree(path)
        return ""
    except OSError as error:
        return short(error, 500)


def process_group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except OSError:
        return True


def signal_process_group(process, sig):
    try:
        os.killpg(process.pid, sig)
        return ""
    except ProcessLookupError:
        return "already exited"
    except OSError as error:
        return short(error, 500)


def wait_after_signal(process, timeout):
    try:
        process.wait(timeout=timeout)
        return False
    except subprocess.TimeoutExpired:
        return True


def wait_for_process_group_exit(pgid, timeout):
    deadline = time.monotonic() + max(0, timeout)
    while process_group_alive(pgid) and time.monotonic() < deadline:
        time.sleep(0.05)
    return not process_group_alive(pgid)


def reap_process_group(process, grace_seconds=1):
    notes = []
    pgid = process.pid
    had_remaining_processes = process_group_alive(pgid)
    if not had_remaining_processes:
        return notes, False, False

    term_error = signal_process_group(process, signal.SIGTERM)
    if term_error and term_error != "already exited":
        notes.append(f"SIGTERM: {term_error}")
    if not wait_for_process_group_exit(pgid, grace_seconds):
        kill_error = signal_process_group(process, signal.SIGKILL)
        if kill_error and kill_error != "already exited":
            notes.append(f"SIGKILL: {kill_error}")
        wait_for_process_group_exit(pgid, 5)
    still_alive = process_group_alive(pgid)
    if still_alive:
        notes.append("process group remained alive after SIGKILL")
    return notes, still_alive, had_remaining_processes


def close_process_pipes(process):
    for stream in (process.stdin, process.stdout, process.stderr):
        try:
            stream.close()
        except Exception:
            pass


def cleanup_failed_process_io_start(process, process_io):
    cleanup_failed = False
    try:
        if process_io is not None:
            process_io.close_unstarted_streams()
    except Exception:
        cleanup_failed = True
    try:
        signal_process_group(process, signal.SIGTERM)
        still_running = wait_after_signal(process, 0)
        if still_running:
            signal_process_group(process, signal.SIGKILL)
            cleanup_failed = wait_after_signal(process, 5) or cleanup_failed
        reap_process_group(process, grace_seconds=0)
    except Exception:
        cleanup_failed = True
    if process_io is not None:
        try:
            process_io.finish(timeout=1)
        except Exception:
            cleanup_failed = True
        finally:
            process_io.close_stopped_streams()
    else:
        close_process_pipes(process)
    try:
        cleanup_failed = (
            process.poll() is None
            or process_group_alive(process.pid)
            or cleanup_failed
        )
    except Exception:
        cleanup_failed = True
    return cleanup_failed


def start_bounded_process_io(process, prompt, **kwargs):
    process_io = None
    try:
        process_io = BoundedProcessIO(process, prompt, **kwargs)
        process_io.start()
        return process_io
    except BaseException as error:
        cleanup_failed = cleanup_failed_process_io_start(process, process_io)
        if not isinstance(error, Exception):
            raise
        if cleanup_failed:
            raise BoundedCaptureError(
                "bounded subprocess I/O startup cleanup failed"
            ) from None
        raise BoundedCaptureError(
            f"bounded subprocess I/O failed to start: {type(error).__name__}"
        ) from None


