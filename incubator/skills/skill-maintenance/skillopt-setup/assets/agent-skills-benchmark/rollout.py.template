def redact(text):
    return str(text or "").replace(str(Path.home()), "~")


def short(text, limit=8000):
    value = redact(text)
    return value if len(value) <= limit else f"{value[:limit]}..."


def as_text(value):
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value)


def normalize_task_prompt(prompt, skill_name="drawio-diagrams"):
    text = str(prompt or "")
    return (
        text.replace(f"${skill_name}", "the provided Agent Skill body")
        .replace(f"@{skill_name}", "the provided Agent Skill body")
    )


def config_bool(value):
    if isinstance(value, bool):
        return value
    return str(value or "").strip().lower() in {"1", "true", "yes", "on"}


def has_visual_assertions(case):
    assertions = case.get("visual_assertions") or []
    if not isinstance(assertions, list):
        return False
    return any(str(assertion or "").strip() for assertion in assertions)


def find_drawio_cli():
    for command in ("drawio", "diagrams.net"):
        executable = shutil.which(command)
        if executable:
            try:
                resolved = Path(executable).resolve(strict=True)
            except OSError:
                continue
            if resolved.is_file():
                return {"command": command, "path": str(resolved)}
    return None


def toml_string(value):
    return json.dumps(str(value))


def safe_rmtree(path):
    try:
        shutil.rmtree(path)
        return ""
    except OSError as error:
        return short(error, 500)


def process_group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except OSError:
        return True


def signal_process_group(process, sig):
    try:
        os.killpg(process.pid, sig)
        return ""
    except ProcessLookupError:
        return "already exited"
    except OSError as error:
        return short(error, 500)


def communicate_after_signal(process, timeout):
    try:
        stdout, stderr = process.communicate(timeout=timeout)
        return as_text(stdout), as_text(stderr), False
    except subprocess.TimeoutExpired as error:
        return as_text(error.stdout), as_text(error.stderr), True


def wait_for_process_group_exit(pgid, timeout):
    deadline = time.monotonic() + max(0, timeout)
    while process_group_alive(pgid) and time.monotonic() < deadline:
        time.sleep(0.05)
    return not process_group_alive(pgid)


def reap_process_group(process, grace_seconds=1):
    notes = []
    pgid = process.pid
    had_remaining_processes = process_group_alive(pgid)
    if not had_remaining_processes:
        return notes, False, False

    term_error = signal_process_group(process, signal.SIGTERM)
    if term_error and term_error != "already exited":
        notes.append(f"SIGTERM: {term_error}")
    if not wait_for_process_group_exit(pgid, grace_seconds):
        kill_error = signal_process_group(process, signal.SIGKILL)
        if kill_error and kill_error != "already exited":
            notes.append(f"SIGKILL: {kill_error}")
        wait_for_process_group_exit(pgid, 5)
    still_alive = process_group_alive(pgid)
    if still_alive:
        notes.append("process group remained alive after SIGKILL")
    return notes, still_alive, had_remaining_processes


def start_process_group_reaper(process, grace_seconds=0):
    state = {}

    def wait_and_reap():
        process.wait()
        state["result"] = reap_process_group(process, grace_seconds)

    thread = Thread(target=wait_and_reap, name="skillopt-process-group-reaper", daemon=True)
    thread.start()
    return thread, state


