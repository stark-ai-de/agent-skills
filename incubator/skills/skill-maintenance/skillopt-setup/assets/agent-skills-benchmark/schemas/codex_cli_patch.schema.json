{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["patch", "source_type"],
  "properties": {
    "patch": {
      "type": "object",
      "required": ["reasoning", "edits"],
      "properties": {
        "reasoning": {
          "type": "string",
          "maxLength": 1000
        },
        "edits": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["op", "target", "content", "source_type"],
            "properties": {
              "op": {
                "enum": ["append", "insert_after", "replace"]
              },
              "target": {
                "type": "string",
                "maxLength": 200
              },
              "content": {
                "type": "string",
                "maxLength": 4000
              },
              "source_type": {
                "enum": ["failure", "success", "mixed"]
              }
            }
          }
        }
      }
    },
    "source_type": {
      "enum": ["failure", "success", "mixed"]
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "failure_summary": {
      "type": "array"
    }
  }
}
