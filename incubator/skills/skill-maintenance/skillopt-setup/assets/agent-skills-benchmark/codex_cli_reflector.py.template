import json
import os
import re
import shutil
import signal
import subprocess
import tempfile
import time
from pathlib import Path
from threading import Thread


REFLECTOR_PERMISSION_PROFILE = "skillopt_reflector"


def _toml_string(value):
    return json.dumps(str(value))


def _path_is_within(path, root):
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def _codex_runtime_read_path(command):
    candidate = Path(str(command or "codex")).expanduser()
    if not candidate.is_absolute():
        resolved = shutil.which(str(candidate))
        if not resolved:
            return None
        candidate = Path(resolved)
    try:
        executable = candidate.resolve(strict=True)
    except OSError:
        return None
    runtime_path = executable
    for parent in executable.parents:
        package_json = parent / "package.json"
        if not package_json.is_file():
            continue
        try:
            package = json.loads(package_json.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        package_name = str(package.get("name") or "")
        if package_name == "@openai/codex" or package_name.startswith("@openai/codex-"):
            runtime_path = parent
            break
    forbidden_roots = [(Path.home() / ".codex").resolve()]
    if os.environ.get("CODEX_HOME"):
        forbidden_roots.append(Path(os.environ["CODEX_HOME"]).expanduser().resolve())
    if runtime_path in {Path(runtime_path.anchor), Path.home()}:
        return None
    if any(_path_is_within(runtime_path, root) for root in forbidden_roots):
        return None
    return runtime_path


def _text_filesystem_permissions(command):
    entries = ['":minimal"="read"']
    runtime_path = _codex_runtime_read_path(command)
    if runtime_path is not None:
        entries.append(f"{_toml_string(runtime_path)}=\"read\"")
    return "{" + ",".join(entries) + "}"


def _minimal_codex_environment():
    allowed = (
        "HOME",
        "PATH",
        "USER",
        "LOGNAME",
        "SHELL",
        "TMPDIR",
        "TEMP",
        "TMP",
        "LANG",
        "LC_ALL",
        "LC_CTYPE",
        "TERM",
        "COLORTERM",
        "NO_COLOR",
        "CODEX_HOME",
        "SSL_CERT_FILE",
        "SSL_CERT_DIR",
    )
    return {key: os.environ[key] for key in allowed if os.environ.get(key)}


def _toml_inline_string_map(values):
    return "{" + ",".join(
        f"{_toml_string(key)}={_toml_string(value)}" for key, value in values.items()
    ) + "}"


def _shell_environment(workspace, process_env):
    temp_dir = Path(workspace) / ".tmp"
    temp_dir.mkdir(mode=0o700)
    values = {
        "HOME": str(workspace),
        "PATH": process_env.get("PATH", os.defpath),
        "TMPDIR": str(temp_dir),
        "TMP": str(temp_dir),
        "TEMP": str(temp_dir),
    }
    for key in ("LANG", "LC_ALL", "LC_CTYPE", "TERM", "COLORTERM", "NO_COLOR"):
        if process_env.get(key):
            values[key] = process_env[key]
    return values


def _process_group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except OSError:
        return True


def _reap_process_group(process, grace_seconds=1):
    if not _process_group_alive(process.pid):
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + grace_seconds
    while _process_group_alive(process.pid) and time.monotonic() < deadline:
        time.sleep(0.05)
    if _process_group_alive(process.pid):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            return


def _start_process_group_reaper(process):
    thread = Thread(
        target=lambda: (process.wait(), _reap_process_group(process)),
        name="skillopt-reflector-process-reaper",
        daemon=True,
    )
    thread.start()
    return thread


def _run_isolated_codex(command, cwd, env, timeout):
    process = subprocess.Popen(
        command,
        cwd=cwd,
        env=env,
        stdin=subprocess.DEVNULL,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    reaper = _start_process_group_reaper(process)
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        _reap_process_group(process)
        try:
            process.communicate(timeout=1)
        except subprocess.TimeoutExpired:
            pass
        raise
    finally:
        reaper.join(timeout=7)
        if reaper.is_alive() or _process_group_alive(process.pid):
            _reap_process_group(process)
    return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)


SECRET_PATTERN = re.compile(r"(sk-[A-Za-z0-9_-]{20,}|[A-Za-z0-9_-]{32,})")
FORBIDDEN_OPTIMIZER_PATTERN = re.compile(r"codex[-_\s]?opt", re.IGNORECASE)


def _extract_json_payload(text):
    value = (text or "").strip()
    if not value:
        return {}
    if value.startswith("```"):
        value = re.sub(r"^```(?:json)?\s*", "", value)
        value = re.sub(r"\s*```$", "", value)
    decoder = json.JSONDecoder()
    for index, char in enumerate(value):
        if char not in "{[":
            continue
        try:
            payload, _ = decoder.raw_decode(value[index:])
            return payload
        except json.JSONDecodeError:
            continue
    return {}


class CodexCliReflector:
    def __init__(self, env):
        self.env = env
        self.timeout = int(env.get("codex_cli_reflection_timeout", 240))
        self.codex_path = str(env.get("codex_exec_path") or "codex")
        self.model = str(env.get("codex_cli_reflection_model") or "").strip()
        self.profile = str(env.get("codex_exec_profile") or "").strip()
        self.edit_budget = max(1, int(env.get("edit_budget") or 2))

    def reflect(self, results, skill_content, out_dir, **kwargs):
        if not results:
            return []
        failures = sum(1 for item in results if not item.get("hard"))
        successes = len(results) - failures
        print(
            f"    [agent_skills reflection] codex_cli results={len(results)} failures={failures} successes={successes}",
            flush=True,
        )
        with tempfile.TemporaryDirectory(prefix="skillopt-codex-reflect-") as tmp:
            out = Path(tmp) / "patch.json"
            prompt = self._prompt(results, skill_content, kwargs)
            process_env = _minimal_codex_environment()
            shell_env = _shell_environment(tmp, process_env)
            command = [
                self.codex_path,
                "exec",
                "--ignore-user-config",
                "--ignore-rules",
                "--skip-git-repo-check",
                "--ephemeral",
                "--color",
                "never",
                "--output-last-message",
                str(out),
                "--strict-config",
                "-c",
                f"default_permissions={_toml_string(REFLECTOR_PERMISSION_PROFILE)}",
                "-c",
                (
                    f"permissions.{REFLECTOR_PERMISSION_PROFILE}.filesystem="
                    f"{_text_filesystem_permissions(self.codex_path)}"
                ),
                "-c",
                f"permissions.{REFLECTOR_PERMISSION_PROFILE}.network.enabled=false",
                "-c",
                'shell_environment_policy.inherit="none"',
                "-c",
                f"shell_environment_policy.set={_toml_inline_string_map(shell_env)}",
            ]
            if self.model:
                command.extend(["--model", self.model])
            if self.profile:
                command.extend(["--profile", self.profile])
            command.append(prompt)
            try:
                completed = _run_isolated_codex(
                    command,
                    tmp,
                    process_env,
                    self.timeout,
                )
            except (OSError, subprocess.TimeoutExpired) as error:
                print(f"    [agent_skills reflection skipped] codex_cli failed: {error}", flush=True)
                return []
            if completed.returncode != 0:
                print(
                    f"    [agent_skills reflection skipped] codex_cli exited {completed.returncode}",
                    flush=True,
                )
                return []
            payload_text = out.read_text(encoding="utf-8") if out.exists() else completed.stdout
            payload = _extract_json_payload(payload_text)
            source_type = "failure" if failures else "success"
            patches = self._normalise_payload(
                payload,
                batch_size=len(results),
                source_type=source_type,
            )
            patches_dir = Path(out_dir) / "patches"
            patches_dir.mkdir(parents=True, exist_ok=True)
            valid_patches = []
            for index, patch in enumerate(patches):
                try:
                    self._validate_patch(patch)
                except ValueError as error:
                    print(
                        f"    [agent_skills reflection skipped patch] {error}",
                        flush=True,
                    )
                    continue
                valid_patches.append(patch)
                (patches_dir / f"codex_cli_reflection_{index:03d}.json").write_text(
                    json.dumps(patch, ensure_ascii=False, indent=2),
                    encoding="utf-8",
                )
            print(
                f"    [agent_skills reflection done] patches={len(valid_patches)}",
                flush=True,
            )
            return valid_patches

    def _prompt(self, results, skill_content, kwargs):
        failures = [item for item in results if not item.get("hard")]
        successes = [item for item in results if item.get("hard")]
        update_mode = kwargs.get("update_mode", "patch")
        return (
            "Return exactly one JSON object only, with no markdown and no second object. "
            "Produce bounded SkillOpt RawPatch objects for an Agent Skill body. "
            "Use this shape: {\"raw_patches\":[{\"source_type\":\"failure\","
            "\"patch\":{\"reasoning\":\"...\",\"edits\":[{\"op\":\"replace\","
            "\"target\":\"exact text\",\"content\":\"replacement text\"}]}}]}. "
            f"Return at most {self.edit_budget} edits total. "
            "Return an empty raw_patches list when no useful edit is justified. "
            "Do not include frontmatter, secrets, local auth paths, or whole-skill rewrites.\n\n"
            f"Update mode: {update_mode}\n\n"
            f"Current skill:\n{skill_content[:8000]}\n\n"
            f"Failures:\n{json.dumps(failures, ensure_ascii=False)[:8000]}\n\n"
            f"Successes:\n{json.dumps(successes, ensure_ascii=False)[:5000]}"
        )

    def _normalise_payload(self, payload, batch_size, source_type):
        if isinstance(payload, dict) and isinstance(payload.get("raw_patches"), list):
            candidates = payload["raw_patches"]
        elif isinstance(payload, list):
            candidates = payload
        elif isinstance(payload, dict) and "patch" in payload:
            candidates = [payload]
        elif isinstance(payload, dict) and "edits" in payload:
            candidates = [{"source_type": "failure", "patch": payload}]
        else:
            return []

        edits = []
        reasoning = []
        seen = set()
        for candidate in candidates:
            if not isinstance(candidate, dict):
                continue
            patch = candidate.get("patch", candidate)
            if not isinstance(patch, dict):
                continue
            if patch.get("reasoning"):
                reasoning.append(str(patch.get("reasoning")))
            for edit in patch.get("edits", []):
                if not isinstance(edit, dict):
                    continue
                key = json.dumps(edit, sort_keys=True, ensure_ascii=False)
                if key in seen:
                    continue
                seen.add(key)
                edit = dict(edit)
                edit.setdefault("source_type", candidate.get("source_type", source_type))
                edits.append(edit)

        if not edits:
            return []

        selected = edits[: self.edit_budget]
        merged_reasoning = " ".join(reasoning).strip() or "codex_cli local merge"
        if len(edits) > len(selected):
            merged_reasoning += f" [codex-cli local truncation {len(edits)}->{len(selected)} edits]"
        return [
            {
                "source_type": source_type,
                "batch_size": batch_size,
                "patch": {
                    "reasoning": merged_reasoning,
                    "edits": selected,
                },
            }
        ]

    def _validate_patch(self, payload):
        text = json.dumps(payload, ensure_ascii=False)
        if "---" in text:
            raise ValueError("patch must not include frontmatter")
        if SECRET_PATTERN.search(text):
            raise ValueError("patch contains a secret-like string")
        if FORBIDDEN_OPTIMIZER_PATTERN.search(text):
            raise ValueError("patch references an unsupported optimizer source")
        edits = payload.get("patch", {}).get("edits", [])
        if len(edits) > 8:
            raise ValueError("patch exceeds edit budget")
        for edit in edits:
            if edit.get("op") == "replace_all":
                raise ValueError("whole-skill replacement is disabled in patch mode")
