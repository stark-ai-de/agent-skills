{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "buildCommand": "pnpm --filter @stark-ai/openai-ads-mcp run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 120,
      "includeFiles": "dist/{references/advertiser-contract.json,migrations/*.sql}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/mcp", "destination": "/api/index" },
    { "source": "/oauth/(.*)", "destination": "/api/index" },
    { "source": "/connections", "destination": "/api/index" },
    { "source": "/credentials/(.*)", "destination": "/api/index" },
    { "source": "/.well-known/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/internal/prune", "destination": "/api/index" }
  ],
  "crons": [{ "path": "/internal/prune", "schedule": "0 3 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
