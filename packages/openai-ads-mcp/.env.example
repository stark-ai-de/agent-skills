# Template only. Set real secrets privately in the selected Vercel environment.
# Remote PostgreSQL must verify TLS; use the provider's actual URL, not this placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_POOLED_HOST/ads?sslmode=verify-full
# Migration-only direct URL; keep out of the runtime deployment if not needed there.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR_DIRECT_HOST/ads?sslmode=verify-full
ADS_DEPLOYMENT_ENVIRONMENT=production
ADS_PUBLIC_ORIGIN=https://ads-mcp.example.com
ADS_ENCRYPTION_KEY=REPLACE_WITH_CANONICAL_BASE64_32_RANDOM_BYTES
ADS_OAUTH_CLIENTS='[{"clientId":"stark-ai-ads-chatgpt","redirectUris":["https://chatgpt.com/connector_platform_oauth_redirect"]}]'
CRON_SECRET=REPLACE_WITH_A_DISTINCT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Preview is disabled by default. To enable it, use a distinct empty/test database,
# encryption key, exact origin, OAuth client and cron secret; migrate as preview.
ADS_ENABLE_NON_PRODUCTION=0
ADS_ALLOWED_ORIGINS=
OPENAI_APPS_CHALLENGE=
