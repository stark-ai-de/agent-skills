# Replace this reserved example domain with your service's real public HTTPS origin.
ADS_PUBLIC_ORIGIN=https://ads-mcp.example.com

# Absolute paths outside the checkout. See README.md for ownership and permissions.
ADS_DATA_DIR=/srv/stark-ai-ads/data
ADS_ENCRYPTION_KEY_PATH=/etc/stark-ai-ads/encryption.key
ADS_OAUTH_CLIENTS_PATH=/etc/stark-ai-ads/oauth-clients.json

# Bound to 127.0.0.1 on the host; terminate HTTPS at your reverse proxy.
ADS_BIND_PORT=8789

# Optional comma-separated extra origins. The service origin, ChatGPT and Platform are included.
ADS_ALLOWED_ORIGINS=

# Optional public challenge supplied by the OpenAI submission portal. This is not an API key.
OPENAI_APPS_CHALLENGE=
