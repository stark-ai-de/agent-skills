{
  "name": "agent-skills",
  "version": "0.2.0",
  "private": true,
  "description": "Public Agent Skills catalog for Codex operations, repo maintenance, skill maintenance, productivity, and engineering workflows.",
  "keywords": [
    "adr",
    "agent-skills",
    "ai-agents",
    "codex",
    "developer-tools",
    "openai-codex",
    "pr-review",
    "release-management",
    "repository-maintenance",
    "skills",
    "workflow-automation"
  ],
  "homepage": "https://github.com/stark-ai-de/agent-skills#readme",
  "bugs": {
    "url": "https://github.com/stark-ai-de/agent-skills/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "servrox solutions UG",
    "email": "dev@stark-ai.de",
    "url": "https://stark-ai.de"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stark-ai-de/agent-skills.git"
  },
  "files": [
    "skills",
    "incubator",
    "skill-evals",
    "docs",
    "scripts",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "oxfmt.json",
    "oxlint.json"
  ],
  "type": "module",
  "scripts": {
    "list": "node scripts/list-skills.mjs",
    "list:incubator": "node scripts/list-incubator-skills.mjs",
    "validate": "npm run validate:skills && npm run validate:adrs && node --check scripts/list-skills.mjs && node --check scripts/list-incubator-skills.mjs && node --check scripts/validate-skills.mjs && node --check scripts/validate-adrs.mjs && node --check scripts/new-adr.mjs && node --check scripts/scaffold-skill.mjs && node --check scripts/smoke-install.mjs && node --check scripts/prepare-release.mjs && node --check scripts/validate-release.mjs && node --check scripts/print-release-notes.mjs && bash -n incubator/skills/codex-operations/codex-memory-curator/scripts/*.sh",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "release:notes": "node scripts/print-release-notes.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:adrs": "node scripts/validate-adrs.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "adr:new": "node scripts/new-adr.mjs",
    "scaffold": "node scripts/scaffold-skill.mjs",
    "scaffold:incubator": "node scripts/scaffold-skill.mjs --incubator",
    "format": "oxfmt --config oxfmt.json --ignore-path .oxfmtignore --write .",
    "format:check": "oxfmt --config oxfmt.json --ignore-path .oxfmtignore --check .",
    "lint": "oxlint --config oxlint.json scripts",
    "lint:fix": "oxlint --config oxlint.json --fix scripts"
  },
  "devDependencies": {
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.0.9"
}
