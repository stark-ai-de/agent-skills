{
  "name": "agent-skills",
  "version": "0.21.0",
  "private": true,
  "description": "Public Agent Skills catalog for Codex operations, Cursor operations, Claude operations, repo maintenance, skill maintenance, productivity, and engineering workflows.",
  "keywords": [
    "adr",
    "agent-skills",
    "ai-agents",
    "anthropic-claude",
    "claude-code",
    "codex",
    "cursor",
    "developer-tools",
    "openai-codex",
    "pr-review",
    "release-management",
    "repository-maintenance",
    "skills",
    "workflow-automation"
  ],
  "homepage": "https://github.com/stark-ai-de/agent-skills#readme",
  "bugs": {
    "url": "https://github.com/stark-ai-de/agent-skills/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "servrox solutions UG",
    "email": "dev@stark-ai.de",
    "url": "https://stark-ai.de"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stark-ai-de/agent-skills.git"
  },
  "files": [
    "skills",
    "plugins",
    "incubator",
    "skill-evals",
    "site",
    "docs",
    "scripts",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "oxfmt.json",
    "oxlint.json"
  ],
  "type": "module",
  "scripts": {
    "list": "bun --bun scripts/catalog/list-skills.mjs",
    "list:incubator": "bun --bun scripts/catalog/list-incubator-skills.mjs",
    "validate": "bun exec \"pnpm run validate:skills && pnpm run validate:memory-curators && pnpm run validate:adrs && pnpm run validate:runtime-matrix && pnpm run validate:ownership && pnpm run validate:bundles && pnpm run validate:release-descriptor && pnpm run validate:contract-snapshots && pnpm run validate:traceability && pnpm run validate:openai && pnpm run validate:projections && pnpm run validate:plugin-evals && pnpm run validate:network-endpoints && pnpm run verify:supply-chain && pnpm run validate:architecture-compass && pnpm run lint:actions && pnpm run validate:scripts && pnpm run validate:release-subject && pnpm run validate:codegraph-ast-grep && pnpm run validate:drawio && pnpm run validate:animated-readme-logo && pnpm run validate:site\"",
    "release:prepare": "bun --bun scripts/release/prepare-release.mjs",
    "release:intent": "bun --bun scripts/release/check-release-intent.mjs",
    "release:validate": "bun --bun scripts/release/validate-release.mjs",
    "release:notes": "bun --bun scripts/release/print-release-notes.mjs",
    "release:reconcile": "bun --bun scripts/release/reconcile-github-release.mjs",
    "release:manage": "bun --bun scripts/release/manage-release.mjs",
    "validate:skills": "bun --bun scripts/catalog/validate-skills.mjs",
    "validate:memory-curators": "node scripts/validation/memory-curators/validate.mjs",
    "validate:adrs": "bun --bun scripts/validation/adrs/validate.mjs",
    "validate:runtime-matrix": "bun --bun scripts/validation/test-runtime-evidence-matrix.mjs",
    "validate:ownership": "bun --bun scripts/validation/test-validation-ownership.mjs",
    "validate:bundles": "bun exec \"bun --bun scripts/plugin/validate-bundles.mjs && bun --bun scripts/validation/test-bundle-contract.mjs\"",
    "validate:openai": "bun exec \"bun --bun scripts/plugin/validate-openai-listing.mjs && bun --bun scripts/plugin/validate-openai-marketplace.mjs && bun --bun scripts/validation/test-openai-contract.mjs && bun --bun scripts/validation/test-openai-directory.mjs && bun --bun scripts/validation/test-listing-identity.mjs && bun --bun scripts/validation/test-openai-icons.mjs\"",
    "generate:openai-worksheet": "bun --bun scripts/plugin/generate-openai-submission-worksheet.mjs",
    "validate:openai-worksheet": "bun --bun scripts/plugin/generate-openai-submission-worksheet.mjs --check",
    "validate:projections": "bun exec \"bun --bun scripts/plugin/sync-agent-plugin.mjs --check && bun --bun scripts/plugin/validate-agent-plugin.mjs && bun --bun scripts/validation/test-plugin-projections.mjs\"",
    "validate:archives": "bun --bun scripts/release/validate-archives.mjs",
    "validate:network-endpoints": "bun --bun scripts/plugin/validate-network-endpoints.mjs",
    "validate:release-proof": "bun exec \"pnpm run validate:archives && pnpm run verify:release-reproducibility && pnpm run validate:network-endpoints && pnpm run validate:release-descriptor && pnpm run validate:contract-snapshots && pnpm run verify:supply-chain\"",
    "sync:agent-plugin": "bun --bun scripts/plugin/sync-agent-plugin.mjs",
    "sync:openai-plugin": "bun --bun scripts/plugin/sync-openai-plugin.mjs",
    "sync:standalone-skills": "bun --bun scripts/plugin/sync-standalone-skills.mjs",
    "validate:agent-plugin": "bun --bun scripts/plugin/validate-agent-plugin.mjs",
    "validate:openai-plugin": "bun --bun scripts/plugin/validate-openai-plugin.mjs",
    "validate:openai-listing": "bun --bun scripts/plugin/validate-openai-listing.mjs",
    "validate:openai-marketplace": "bun --bun scripts/plugin/validate-openai-marketplace.mjs",
    "validate:openai-submission": "bun --bun scripts/plugin/validate-openai-submission.mjs",
    "validate:standalone-skills": "bun --bun scripts/plugin/validate-standalone-skills.mjs",
    "validate:plugin-evals": "bun exec \"bun --bun scripts/plugin/validate-plugin-evals.mjs && bun --bun scripts/validation/test-plugin-evals.mjs\"",
    "validate:release-descriptor": "bun exec \"bun --bun scripts/plugin/validate-release-descriptor.mjs && bun --bun scripts/validation/test-release-descriptor.mjs\"",
    "validate:contract-snapshots": "bun --bun scripts/plugin/validate-contract-snapshots.mjs",
    "generate:openai-marketplace-fixture": "bun --bun scripts/plugin/generate-openai-marketplace-fixture.mjs",
    "generate:traceability": "bun --bun scripts/repo/generate-traceability.mjs",
    "validate:traceability": "bun --bun scripts/repo/generate-traceability.mjs --check",
    "verify:supply-chain": "bun --bun scripts/release/verify-supply-chain.mjs",
    "validate:post-release-receipt": "bun --bun scripts/release/validate-post-release-receipt.mjs",
    "validate:release-subject": "bun --bun scripts/validation/test-release-subject.mjs",
    "validate:release-management": "bun exec \"bun --bun scripts/validation/test-release-environment.mjs && bun --bun scripts/validation/test-release-management.mjs\"",
    "validate:release-subject-file": "bun --bun scripts/release/validate-release-subject.mjs",
    "test:post-release-receipt": "bun exec \"bun --bun scripts/validation/test-post-release-receipt.mjs && bun --bun scripts/validation/test-release-reconciler.mjs\"",
    "package:agent-plugin": "bun --bun scripts/plugin/package-agent-plugin.mjs",
    "package:openai-plugin": "bun --bun scripts/plugin/package-openai-plugin.mjs",
    "package:standalone-skills": "bun --bun scripts/plugin/package-standalone-skills.mjs",
    "verify:release-reproducibility": "bun --bun scripts/release/verify-release-reproducibility.mjs",
    "verify:openai-directory": "bun --bun scripts/plugin/verify-openai-directory.mjs",
    "build:release-subjects": "bun --bun scripts/release/verify-release-reproducibility.mjs --subjects-dir dist/release-subjects",
    "generate:release-evidence": "bun --bun scripts/release/verify-release-reproducibility.mjs --evidence docs/listing/openai/stark-ai-developer-release-evidence.json",
    "validate:architecture-compass": "bun --bun scripts/validation/architecture-compass/validate.mjs",
    "validate:codegraph-ast-grep": "bun --bun scripts/validation/codegraph-ast-grep/validate-contract.mjs",
    "validate:drawio": "bun exec \"bun --bun scripts/validation/drawio-diagrams/validate-fixtures.mjs && bun --bun scripts/validation/drawio-diagrams/validate-visual-evals.mjs\"",
    "validate:animated-readme-logo": "bun exec \"bun --bun scripts/validation/animated-readme-logo/validate-runtime.mjs && bun --bun scripts/validation/animated-readme-logo/validate-evals.mjs\"",
    "validate:skillopt": "bun --bun scripts/validation/skillopt-setup/validate-setup.mjs",
    "validate:scripts": "bun exec \"bun --bun scripts/repo/validate-scripts.mjs && pnpm run validate:release-management\"",
    "validate:site": "pnpm --filter ./site run build",
    "smoke:install": "bun --bun scripts/repo/smoke-install.mjs",
    "smoke:fingerprint": "bun --bun scripts/repo/fingerprint-smoke-candidate.mjs",
    "adr:new": "bun --bun scripts/catalog/new-adr.mjs",
    "scaffold": "bun --bun scripts/catalog/scaffold-skill.mjs",
    "scaffold:incubator": "bun --bun scripts/catalog/scaffold-skill.mjs --incubator",
    "format": "oxfmt --config oxfmt.json --ignore-path .oxfmtignore --threads=1 --write .",
    "format:check": "oxfmt --config oxfmt.json --ignore-path .oxfmtignore --threads=1 --check .",
    "lint": "oxlint --config oxlint.json scripts",
    "lint:actions": "bun --bun scripts/repo/lint-actions.mjs",
    "lint:fix": "oxlint --config oxlint.json --fix scripts"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "github-actionlint": "1.7.12",
    "js-yaml": "5.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "semver": "7.8.5"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.24.0"
}
