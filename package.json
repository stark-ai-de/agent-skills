{
  "name": "agent-skills",
  "version": "0.21.0",
  "private": true,
  "description": "Public Agent Skills catalog for Codex operations, Cursor operations, Claude operations, repo maintenance, skill maintenance, productivity, and engineering workflows.",
  "keywords": [
    "adr",
    "agent-skills",
    "ai-agents",
    "anthropic-claude",
    "claude-code",
    "codex",
    "cursor",
    "developer-tools",
    "openai-codex",
    "pr-review",
    "release-management",
    "repository-maintenance",
    "skills",
    "workflow-automation"
  ],
  "homepage": "https://github.com/stark-ai-de/agent-skills#readme",
  "bugs": {
    "url": "https://github.com/stark-ai-de/agent-skills/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "servrox solutions UG",
    "email": "dev@stark-ai.de",
    "url": "https://stark-ai.de"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stark-ai-de/agent-skills.git"
  },
  "files": [
    "skills",
    "plugins",
    "incubator",
    "skill-evals",
    "site",
    "docs",
    "scripts",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "oxfmt.json",
    "oxlint.json"
  ],
  "type": "module",
  "scripts": {
    "list": "node scripts/catalog/list-skills.mjs",
    "list:incubator": "node scripts/catalog/list-incubator-skills.mjs",
    "validate": "npm run validate:skills && npm run validate:memory-curators && npm run validate:adrs && npm run validate:ownership && npm run validate:bundles && npm run validate:release-descriptor && npm run validate:contract-snapshots && npm run validate:traceability && npm run validate:openai && npm run validate:projections && npm run validate:plugin-evals && npm run validate:network-endpoints && npm run verify:supply-chain && npm run validate:architecture-compass && npm run lint:actions && npm run validate:scripts && npm run validate:release-subject && npm run validate:codegraph-ast-grep && npm run validate:drawio && npm run validate:animated-readme-logo && npm run validate:site",
    "release:prepare": "node scripts/release/prepare-release.mjs",
    "release:intent": "node scripts/release/check-release-intent.mjs",
    "release:validate": "node scripts/release/validate-release.mjs",
    "release:notes": "node scripts/release/print-release-notes.mjs",
    "release:reconcile": "node scripts/release/reconcile-github-release.mjs",
    "release:manage": "node scripts/release/manage-release.mjs",
    "validate:skills": "node scripts/catalog/validate-skills.mjs",
    "validate:memory-curators": "node scripts/validation/memory-curators/validate.mjs",
    "validate:adrs": "node scripts/validation/adrs/validate.mjs",
    "validate:ownership": "node scripts/validation/test-validation-ownership.mjs",
    "validate:bundles": "node scripts/plugin/validate-bundles.mjs && node scripts/validation/test-bundle-contract.mjs",
    "validate:openai": "node scripts/plugin/validate-openai-listing.mjs && node scripts/plugin/validate-openai-marketplace.mjs && node scripts/validation/test-openai-contract.mjs && node scripts/validation/test-openai-directory.mjs && node scripts/validation/test-listing-identity.mjs && node scripts/validation/test-openai-icons.mjs",
    "generate:openai-worksheet": "node scripts/plugin/generate-openai-submission-worksheet.mjs",
    "validate:openai-worksheet": "node scripts/plugin/generate-openai-submission-worksheet.mjs --check",
    "validate:projections": "node scripts/plugin/sync-agent-plugin.mjs --check && node scripts/plugin/validate-agent-plugin.mjs && node scripts/validation/test-plugin-projections.mjs",
    "validate:archives": "node scripts/release/validate-archives.mjs",
    "validate:network-endpoints": "node scripts/plugin/validate-network-endpoints.mjs",
    "validate:release-proof": "npm run validate:archives && npm run verify:release-reproducibility && npm run validate:network-endpoints && npm run validate:release-descriptor && npm run validate:contract-snapshots && npm run verify:supply-chain",
    "sync:agent-plugin": "node scripts/plugin/sync-agent-plugin.mjs",
    "sync:openai-plugin": "node scripts/plugin/sync-openai-plugin.mjs",
    "sync:standalone-skills": "node scripts/plugin/sync-standalone-skills.mjs",
    "validate:agent-plugin": "node scripts/plugin/validate-agent-plugin.mjs",
    "validate:openai-plugin": "node scripts/plugin/validate-openai-plugin.mjs",
    "validate:openai-listing": "node scripts/plugin/validate-openai-listing.mjs",
    "validate:openai-marketplace": "node scripts/plugin/validate-openai-marketplace.mjs",
    "validate:openai-submission": "node scripts/plugin/validate-openai-submission.mjs",
    "validate:standalone-skills": "node scripts/plugin/validate-standalone-skills.mjs",
    "validate:plugin-evals": "node scripts/plugin/validate-plugin-evals.mjs && node scripts/validation/test-plugin-evals.mjs",
    "validate:release-descriptor": "node scripts/plugin/validate-release-descriptor.mjs && node scripts/validation/test-release-descriptor.mjs",
    "validate:contract-snapshots": "node scripts/plugin/validate-contract-snapshots.mjs",
    "generate:openai-marketplace-fixture": "node scripts/plugin/generate-openai-marketplace-fixture.mjs",
    "generate:traceability": "node scripts/repo/generate-traceability.mjs",
    "validate:traceability": "node scripts/repo/generate-traceability.mjs --check",
    "verify:supply-chain": "node scripts/release/verify-supply-chain.mjs",
    "validate:post-release-receipt": "node scripts/release/validate-post-release-receipt.mjs",
    "validate:release-subject": "node scripts/validation/test-release-subject.mjs",
    "validate:release-management": "node scripts/validation/test-release-environment.mjs && node scripts/validation/test-release-management.mjs",
    "validate:release-subject-file": "node scripts/release/validate-release-subject.mjs",
    "test:post-release-receipt": "node scripts/validation/test-post-release-receipt.mjs && node scripts/validation/test-release-reconciler.mjs",
    "package:agent-plugin": "node scripts/plugin/package-agent-plugin.mjs",
    "package:openai-plugin": "node scripts/plugin/package-openai-plugin.mjs",
    "package:standalone-skills": "node scripts/plugin/package-standalone-skills.mjs",
    "verify:release-reproducibility": "node scripts/release/verify-release-reproducibility.mjs",
    "verify:openai-directory": "node scripts/plugin/verify-openai-directory.mjs",
    "build:release-subjects": "node scripts/release/verify-release-reproducibility.mjs --subjects-dir dist/release-subjects",
    "generate:release-evidence": "node scripts/release/verify-release-reproducibility.mjs --evidence docs/listing/openai/stark-ai-developer-release-evidence.json",
    "validate:architecture-compass": "node scripts/validation/architecture-compass/validate.mjs",
    "validate:codegraph-ast-grep": "node scripts/validation/codegraph-ast-grep/validate-contract.mjs",
    "validate:drawio": "node scripts/validation/drawio-diagrams/validate-fixtures.mjs && node scripts/validation/drawio-diagrams/validate-visual-evals.mjs",
    "validate:animated-readme-logo": "node scripts/validation/animated-readme-logo/validate-runtime.mjs && node scripts/validation/animated-readme-logo/validate-evals.mjs",
    "validate:skillopt": "node scripts/validation/skillopt-setup/validate-setup.mjs",
    "validate:scripts": "node scripts/repo/validate-scripts.mjs && npm run validate:release-management",
    "validate:site": "pnpm --filter ./site build",
    "smoke:install": "node scripts/repo/smoke-install.mjs",
    "smoke:fingerprint": "node scripts/repo/fingerprint-smoke-candidate.mjs",
    "adr:new": "node scripts/catalog/new-adr.mjs",
    "scaffold": "node scripts/catalog/scaffold-skill.mjs",
    "scaffold:incubator": "node scripts/catalog/scaffold-skill.mjs --incubator",
    "format": "oxfmt --config oxfmt.json --ignore-path .oxfmtignore --threads=1 --write .",
    "format:check": "oxfmt --config oxfmt.json --ignore-path .oxfmtignore --threads=1 --check .",
    "lint": "oxlint --config oxlint.json scripts",
    "lint:actions": "node scripts/repo/lint-actions.mjs",
    "lint:fix": "oxlint --config oxlint.json --fix scripts"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "github-actionlint": "1.7.12",
    "js-yaml": "5.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.22.0"
}
