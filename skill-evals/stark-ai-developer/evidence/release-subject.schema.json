{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stark-ai-de/agent-skills/blob/main/skill-evals/stark-ai-developer/evidence/release-subject.schema.json",
  "title": "stark AI Developer versioned release subject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "sourceRevision",
    "releaseVersion",
    "pluginVersion",
    "archiveProfile",
    "subjects",
    "differences"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "status": {
      "enum": ["pass", "blocked", "not_applicable"]
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tag", "state"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
        },
        "tag": {
          "type": "string",
          "pattern": "^(?:v[0-9]+\\.[0-9]+\\.[0-9]+|manual-review-required)$"
        },
        "state": {
          "enum": ["clean", "dirty", "unknown"]
        }
      }
    },
    "releaseVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "pluginVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "archiveProfile": {
      "type": "string",
      "minLength": 1
    },
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openai", "portable"],
      "properties": {
        "openai": {
          "$ref": "#/$defs/archiveSubject"
        },
        "portable": {
          "allOf": [
            {
              "$ref": "#/$defs/archiveSubject"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "portable.zip"
                }
              }
            }
          ]
        },
        "openaiSkillsOnly": {
          "$ref": "#/$defs/archiveSubject"
        }
      }
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "openaiProfile": {
      "$ref": "#/$defs/openaiProfile"
    },
    "openaiSkillsOnlyProfile": {
      "$ref": "#/$defs/openaiProfile"
    }
  },
  "$defs": {
    "archiveSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes"],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "openaiProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "pluginId", "version", "displayName", "transport", "archive"],
      "properties": {
        "profile": {
          "enum": ["existing-skills-only", "existing-remote", "new-remote", "desktop-local"]
        },
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": ["none", "http", "stdio"]
        },
        "archive": {
          "type": "string",
          "pattern": "^dist/openai/[a-z0-9-]+-[0-9]+\\.[0-9]+\\.[0-9]+\\.zip$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "description": {
          "type": "string"
        },
        "listingUrl": {
          "type": "string",
          "pattern": "^https://chatgpt\\.com/plugins/[^/?#]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "type": "object",
        "properties": {
          "subjects": {
            "type": "object",
            "properties": {
              "openai": {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "openai.zip"
                  }
                }
              }
            },
            "not": {
              "properties": {
                "openaiSkillsOnly": {}
              },
              "required": ["openaiSkillsOnly"]
            }
          }
        },
        "not": {
          "properties": {
            "openaiSkillsOnlyProfile": {}
          },
          "required": ["openaiSkillsOnlyProfile"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "type": "object",
        "required": ["openaiProfile", "openaiSkillsOnlyProfile"],
        "properties": {
          "subjects": {
            "type": "object",
            "properties": {
              "openai": {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "openai-tools.zip"
                  }
                }
              },
              "openaiSkillsOnly": {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "openai-skills-only.zip"
                  }
                }
              }
            },
            "required": ["openaiSkillsOnly"]
          },
          "openaiProfile": {
            "type": "object",
            "required": ["listingUrl", "url"],
            "properties": {
              "profile": {
                "const": "new-remote"
              },
              "pluginId": {
                "const": "stark-ai-developer-tools"
              },
              "transport": {
                "const": "http"
              },
              "listingUrl": {
                "const": "https://chatgpt.com/plugins/plugin_asdk_app_6ad281cbc9a481919d8d5e123985ddc8"
              },
              "url": {
                "type": "string",
                "pattern": "^https://skills-mcp\\.stark-ai\\.de/mcp$"
              }
            }
          },
          "openaiSkillsOnlyProfile": {
            "type": "object",
            "required": ["listingUrl"],
            "properties": {
              "profile": {
                "const": "existing-skills-only"
              },
              "pluginId": {
                "const": "stark-ai-developer"
              },
              "transport": {
                "const": "none"
              },
              "listingUrl": {
                "const": "https://chatgpt.com/plugins/plugins_6a85d98a7bc48191879aedd91610271e"
              }
            }
          }
        }
      }
    }
  ]
}
