# Keep working-tree text as LF so zip-store-v1 archives match Git blobs
# on Linux, macOS, and Windows.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.wasm binary

# Generated artifacts retain upstream license and bundle bytes, including whitespace.
vendor/ssh-manager/runtime/** -whitespace linguist-generated=true
plugins/stark-ai-developer/runtime/** -whitespace linguist-generated=true
vendor/ssh-manager/runtime/ARTIFACT-MANIFEST.json linguist-generated=false
